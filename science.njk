<div class="relative overflow-x-clip bg-night text-ink font-body leading-[1.58] antialiased selection:bg-ember selection:text-[#160c02]" style="--acc:var(--color-corn)">
  <div class="v2-ambient" aria-hidden="true"></div>
  <div class="relative z-[1]">

    {# ---------- hero ---------- #}
    <header class="pt-10 pb-[clamp(40px,5vw,60px)]">
    <div class="max-w-[1140px] mx-auto px-7">
      <h1 class="mt-[22px] font-disp font-semibold text-[clamp(2.1rem,5vw,3.7rem)] leading-[1.05] tracking-[-.02em] text-balance max-w-[20ch] [font-variation-settings:'opsz'_96]">Open science infrastructure, shaped by the communities who rely on it.</h1>

      <p class="mt-[36px] text-[1.08rem] text-ink-2 max-w-[62ch] [&_b]:text-ink [&_b]:font-semibold">We partner with universities, scholarly networks and science communicators who <b>run spaces</b> of their own, <b>co-design around real practice</b>, and <b>research how communities actually work</b>, such as experimenting with new forms of governance and open knowledge exchange.</p>

      <p class="mt-5 text-[1.08rem] text-ink-2 max-w-[62ch]">Our collaborations span living labs at Warwick, governance research with Princeton HCI and design experiments with the Prosocial Design Network. The code, design patterns and methods we develop return to the commons, openly licensed.</p>

      <div class="flex flex-wrap gap-3.5 mt-9">
        <a class="{{ btnfire }}" href="#who">Explore our collaborations</a>
        <a class="{{ btnline }}" href="/contact">Propose a collaboration</a>
      </div>
    </div></header>

    <main>

    {# ---------- logo wall. Peers first: for a university reader this band
         does more persuading than any feature description below it. The
         `logo` filter (see .eleventy.js) fetches greyscale logos at build
         time and inlines them, returning "" on failure, so every entry
         falls back to its name set in type. ---------- #}
    <section class="py-[clamp(30px,4vw,44px)] border-t border-ink/[0.07]">
    <div class="max-w-[1140px] mx-auto px-7">
      <h2 class="font-disp font-[560] text-[clamp(1.55rem,2.5vw,2.15rem)] leading-[1.1] tracking-[-.02em] text-ink text-balance [font-variation-settings:'opsz'_72]">Who's running it, building it, or <span class="corn-text">studying it:</span></h2>
      <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-px mt-8 overflow-hidden rounded-xl border border-ink/[0.09] bg-ink/[0.09]">
        {%- for s in strands %}{%- for p in s.partners %}
        <li class="flex bg-night-2">
          {% set src = p.img or (p.dom | logo) %}
          <a class="group/logo flex min-h-[96px] w-full items-center justify-start gap-4 px-6 py-5 transition-colors duration-200 hover:bg-ink/[0.035] focus-visible:outline-2 focus-visible:outline-offset-[-3px] focus-visible:outline-spark min-[521px]:min-h-[132px] min-[521px]:justify-center min-[521px]:px-7 lg:min-h-[150px]" href="{{ p.url or '#who' }}"{% if p.url %} target="_blank" rel="noopener noreferrer"{% endif %}>
            {%- if src %}<img class="h-12 w-12 shrink-0 object-contain opacity-65 grayscale transition-all duration-200 group-hover/logo:opacity-100 group-hover/logo:grayscale-0" src="{{ src }}" alt="" loading="lazy">{% endif -%}
            <span class="font-disp font-[620] text-[1.02rem] leading-[1.2] text-ink-2 transition-colors duration-200 group-hover/logo:text-ink">{{ p.name }}</span>
          </a>
        </li>
        {%- endfor %}{%- endfor %}
      </ul>
      <div class="mt-[42px]">
        <div class="grid grid-cols-1 min-[681px]:grid-cols-2 gap-3.5 mt-5">
      {%- for s in strands %}
          {%- for p in s.partners %}
          <div class="{{ cell }}">
            {% set src = p.img or (p.dom | logo) %}
            <div class="flex items-start justify-between gap-4">
              <p class="{{ sector }}">{{ p.kind }}</p>
              {% if src %}<img class="h-11 w-auto max-w-[140px] object-contain opacity-75 shrink-0" src="{{ src }}" alt="" loading="lazy">{% endif %}
            </div>
            <h4 class="{{ cellh }}">{% if p.url %}<a class="hover:text-spark" href="{{ p.url }}" target="_blank" rel="noopener noreferrer">{{ p.name }} <span class="text-ink-3 text-[.8em]" aria-hidden="true">↗</span></a>{% else %}{{ p.name }}{% endif %}</h4>
            <p class="{{ cellp }}">{{ p.text | safe }}</p>
            {% if p.link %}<div class="mt-3"><a class="{{ cardlink }}" href="{{ p.link }}"{% if '//' in p.link %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ p.linktext }} <span aria-hidden="true">→</span></a></div>{% endif %}
          </div>
          {%- endfor %}
      {%- endfor %}
        </div>
      </div>
    </div>

    </section>



