            <span class="{{ ic }}" aria-hidden="true"><i class="ph-duotone {{ f.icon }}"></i></span>
            <h3 class="{{ cellh }}">{{ f.name }}</h3>
            <p class="{{ cellp }}">{{ f.text }}</p>
          </div>
        </div>
        {%- endfor %}
      </div>
    </div></section>

