                  <span class="font-smono text-[.66rem] text-corn-2 border border-corn-2/40 rounded-[7px] px-2 py-[5px]">Ghost integration</span>
                  <span class="font-smono text-[.66rem] text-corn-2 border border-corn-2/40 rounded-[7px] px-2 py-[5px]">membership sync</span>
                  <span class="font-smono text-[.66rem] text-ink-2 border border-ink/15 rounded-[7px] px-2 py-[5px]">groups &amp; topics</span>
                  <span class="font-smono text-[.66rem] text-ink-2 border border-ink/15 rounded-[7px] px-2 py-[5px]">their own branding</span>
                </div>
              </div>
            </div>
