<script>
(function(){
"use strict";
/* hero: cycle through what each community was actually after */
var wrap=document.getElementById('goals');
if(!wrap)return;
var goals=[].slice.call(wrap.querySelectorAll('.g'));
if(goals.length<2)return;
if(window.matchMedia('(prefers-reduced-motion:reduce)').matches)return; /* leave the first one up */
function show(el){el.classList.remove('absolute','opacity-0','translate-y-2','pointer-events-none');el.classList.add('relative');}
function hide(el){el.classList.remove('relative');el.classList.add('absolute','opacity-0','translate-y-2','pointer-events-none');}
var i=0;
setInterval(function(){
  hide(goals[i]);
  i=(i+1)%goals.length;
  show(goals[i]);
},4200);
})();
</script>
