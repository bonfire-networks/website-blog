<script>
(function(){
"use strict";
/* galleries: arrows + drag-to-scroll; snap pauses while dragging */
document.querySelectorAll('[data-gal]').forEach(function(g){
  var s=g.querySelector('[data-hscroll]');if(!s)return;
  var prev=g.querySelector('.js-prev'),next=g.querySelector('.js-next');
  function step(){var c=s.querySelector('figure');return c?c.getBoundingClientRect().width+20:s.clientWidth*0.8;}
  function sync(){if(!prev)return;prev.disabled=s.scrollLeft<=2;next.disabled=s.scrollLeft>=(s.scrollWidth-s.clientWidth-2);}
  if(prev&&next){
    prev.addEventListener('click',function(){s.scrollBy({left:-step(),behavior:'smooth'});});
    next.addEventListener('click',function(){s.scrollBy({left:step(),behavior:'smooth'});});
  }
  s.addEventListener('scroll',sync,{passive:true});
  window.addEventListener('resize',sync);
  sync();

  var down=false,x0=0,l0=0,moved=0;
  s.addEventListener('pointerdown',function(e){
    if(e.button!==0)return;
    down=true;moved=0;x0=e.clientX;l0=s.scrollLeft;
    s.classList.add('cursor-grabbing','snap-none');
    try{s.setPointerCapture(e.pointerId);}catch(_){}
    e.preventDefault();
  });
  s.addEventListener('pointermove',function(e){
    if(!down)return;
    var dx=e.clientX-x0;moved=Math.abs(dx);
    s.scrollLeft=l0-dx;
    e.preventDefault();
  });
  function end(e){
    if(!down)return;
    down=false;s.classList.remove('cursor-grabbing','snap-none');
    try{s.releasePointerCapture(e.pointerId);}catch(_){}
    sync();
  }
  s.addEventListener('pointerup',end);
  s.addEventListener('pointercancel',end);
  s.addEventListener('click',function(e){if(moved>6)e.preventDefault();},true);
  s.addEventListener('dragstart',function(e){e.preventDefault();});
});
})();
</script>
