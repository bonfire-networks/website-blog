{% from "keila-signup.njk" import keilaSignup %}

<div id="join-us" class="container relative max-w-screen-lg mx-auto mt-16 rubik">
  <div class="relative mx-auto">
    <span class="relative block text-5xl font-bold tracking-wider text-left text-base-content ">Reach out</span>
    {# <div class="w-40 h-2 mx-auto mt-2 transform rounded-full bg-linear-to-r from-pink-600 to-indigo-600 "></div> #}
  </div>
</div>
<div class="prose mb-60 prose-lg max-w-(--breakpoint-md)">
  <p class="mt-5 font-light! md:text-xl text-base-content">We're looking for communities who'd rather shape their tools than be shaped by them, to design and build together for autonomy, mutual care and collective power, and make everything available for everyone to use, remix and experiment with.</p>
  <p class="mt-5 font-light! md:text-xl text-base-content">Want to discuss your needs and see if a Bonfire app or extension might help? Want to contribute to building the Bonfire ecosystem, or get involved some other way?</p>
  <p class="mt-5 font-light! md:text-xl text-base-content">You can contact us <a href="https://bonfire.cafe/@Bonfire">on the fediverse</a>, send an email at <code>team@bonfire.cafe</code>, or <a href="https://cal.com/bonfire-networks/meet" target="_blank" rel="noopener noreferrer">book a call with us</a>.
  <p class="mt-5 font-light! md:text-xl text-base-content">To report abuse of our services or members of our community, please follow our <a href="/conduct">code of conduct</a>, which have more information about what to do.<p>



<div class="mt-20 pt-8 border-t border-base-content/20">
    <div class="flex flex-col gap-3">
      <div class="text-lg font-bold tracking-tight text-base-content sm:block sm:text-3xl">Sign up to our newsletter to stay on top of our latest developments</div>
      <div class="">Your data is private and we will use it only for the purposes of contacting you about Bonfire. You may unsubscribe at any time.</div>
    </div>

      <div class="mt-6 w-full">
        {{ keilaSignup("contact-newsletter") }}
      </div>

</div>

</div>
