    <p class="text-lg text-base-content/70 max-w-xl mb-12">
      No API keys, no tracking scripts, no account to create.
    </p>
    <div class="bg-base-300 rounded-2xl overflow-hidden max-w-2xl shadow-xl relative">
      <button class="telling-copy-btn absolute top-3 right-4 bg-base-content/10 border border-base-content/10 text-base-content/60 rounded-lg px-3 py-2 text-xs font-medium cursor-pointer hover:bg-base-content/20 hover:text-base-content transition-all inline-flex items-center gap-1.5" type="button" onclick="tellingCopyEmbed(this)" aria-label="Copy embed code">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        Copy
      </button>
      <div class="px-4 py-3 flex items-center gap-2 bg-base-content/5">
