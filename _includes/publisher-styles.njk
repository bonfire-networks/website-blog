<style>
.publishers{background:var(--color-night);color:var(--color-ink);font-family:var(--font-body);font-optical-sizing:auto;line-height:1.7}
.publishers *{box-sizing:border-box}
.publisher-layout{display:grid;grid-template-columns:minmax(0,740px) 304px;gap:0 72px;max-width:1200px;margin:auto;padding:72px 32px 96px;align-items:start}
.publisher-copy{min-width:0;grid-column:1}.publisher-layout>header{grid-column:1}
.publishers h1,.publishers h2,.publishers h3{font-family:var(--font-disp);text-wrap:balance;font-weight:600}
.publishers h1{font-size:clamp(2.5rem,4.5vw,3.7rem);line-height:1.06;letter-spacing:-.035em;margin:0 0 28px}
.publisher-layout .publisher-deck{font-family:var(--font-disp);font-size:clamp(1.5rem,2.45vw,2rem);line-height:1.36;letter-spacing:-.015em;text-wrap:pretty;margin:0 0 24px;max-width:35ch}
.publishers p{margin:0 0 20px;text-wrap:pretty}.publisher-layout>header>p:last-child{font-size:1.0625rem;color:var(--color-ink-2);max-width:60ch}
.publishers h2{font-size:clamp(1.65rem,2.5vw,1.95rem);line-height:1.2;letter-spacing:-.02em;margin:56px 0 20px}
.publishers h3{font-size:1.18rem;line-height:1.35;letter-spacing:-.01em;margin:32px 0 10px}
.publisher-copy section{scroll-margin-top:100px}.publisher-copy p,.publisher-copy li{font-size:1.0625rem;max-width:65ch}
.publisher-copy a{color:var(--color-spark);text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:4px}.publisher-copy a:hover{color:#fff1c4}
.publishers a:focus-visible{outline:3px solid var(--color-ember);outline-offset:5px}
.publisher-copy ul{list-style:disc;padding-left:23px;margin:0 0 26px}.publisher-copy li{padding-left:5px;margin-bottom:14px}
.publisher-copy figure{margin:36px 0 40px}.publisher-copy img{display:block;width:100%;height:auto;border-radius:6px;border:1px solid #ffffff18}
.publisher-copy figcaption{font-size:.875rem;line-height:1.6;color:var(--color-ink-2);margin:13px 0 0;max-width:68ch}.publisher-copy figcaption strong{color:var(--color-ink);font-weight:600}
.publisher-offer{grid-column:2;grid-row:1 / span 2;position:sticky;top:88px;color:#231e17;background:#f2ecdb;border:1px solid #fffaf070;border-radius:8px;overflow:hidden}
.publisher-offer-header{padding:24px 24px 20px;border-bottom:1px solid #231e1728}
.publisher-offer-header b{display:block;font-family:var(--font-disp);font-size:1.6rem;line-height:1.2;letter-spacing:-.02em}
.publisher-offer .publisher-offer-header p{margin:10px 0 0}
.publisher-offer-body{padding:24px}.publisher-offer h2{font-size:1.15rem;line-height:1.3;letter-spacing:-.01em;margin:0 0 10px}
.publisher-offer p{font-size:.9375rem;line-height:1.6;margin:0 0 18px;color:#514a3d}
.publisher-offer-path+.publisher-offer-path{border-top:1px solid #231e1728;padding-top:24px;margin-top:24px}
.publisher-cta{display:flex;justify-content:center;align-items:center;text-align:center;min-height:48px;background:#ffdf82;color:#231e17;font-size:.9375rem;font-weight:600;padding:11px 14px;border:1px solid #b99538;border-radius:5px;text-decoration:none}
.publisher-cta:hover{background:#f5c344}.publisher-cta-secondary{background:transparent;border-color:#231e1740}.publisher-cta-secondary:hover{background:#e8dfc9}
.publisher-offer .publisher-other{display:block;color:#514a3d;text-align:center;font-size:.875rem;text-decoration:underline;text-underline-offset:4px;margin-top:16px;padding:4px}
.publisher-copy .publisher-scope-note{font-size:.9375rem;color:var(--color-ink-2)}
.publisher-end{border-top:1px solid #ffffff26;margin-top:48px;padding-top:32px}
@media(min-width:701px) and (max-height:850px){.publisher-offer{position:static}}
@media(max-width:950px){.publisher-layout{column-gap:36px;grid-template-columns:minmax(0,1fr) 280px;padding-inline:24px}.publisher-offer-body,.publisher-offer-header{padding:20px}}
@media(max-width:700px){.publisher-layout{display:flex;flex-direction:column;padding:40px 22px 56px;gap:32px}.publisher-copy{order:2;width:100%}.publisher-layout>header{order:0}.publisher-offer{position:static;order:1;width:100%}.publisher-copy h2{margin-top:40px}.publisher-copy figure{margin:24px 0 32px}.publisher-copy>figure:first-child{margin-top:0}.publisher-layout .publisher-deck{font-size:1.6rem}.publisher-copy .publisher-end{margin-top:32px}}
</style>
