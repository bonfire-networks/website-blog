{# ============================================================
   V2 · 07 · HOW WE BUILD — proof points + woodcut art (Tailwind + daisyUI)
   Requires: v2 tokens in css/index.css
   ============================================================ #}
{% set proofb = "font-disp font-[620] text-[1.14rem] block mb-[3px]" %}
{% set proofs = "text-ink-2 text-[.95rem]" %}
{% set more = "inline-flex items-center gap-[9px] mt-[30px] pb-[3px] font-smono text-[.8rem] tracking-[.05em] text-spark border-b border-spark/35 hover:border-spark" %}

<section id="how" class="py-[clamp(72px,9vw,130px)] border-t border-ink/[0.07] scroll-mt-[70px]">
<div class="max-w-[1140px] mx-auto px-7">
  <div class="grid grid-cols-1 min-[821px]:grid-cols-[1.05fr_1fr] gap-9 min-[821px]:gap-[52px] items-stretch">
    <div>
      <!-- <p class="flex items-center gap-3 font-smono text-[1rem] font-bold tracking-[.18em] text-flame">Are these your people?</p> -->
      <h2 class="mt-[22px] font-disp font-[560] text-[clamp(2rem,4.4vw,3.4rem)] leading-[1.05] text-balance [font-variation-settings:'opsz'_96]">How we build matters more than <span class="fire-text">what we build.</span></h2>
      <div class="grid gap-5 mt-7">
        <div class="grid grid-cols-[auto_1fr] gap-4">
          <span class="w-[9px] h-[9px] mt-2 bg-flame [clip-path:polygon(50%_0,100%_50%,50%_100%,0_50%)] shadow-[0_0_8px_rgba(245,195,68,.6)]" aria-hidden="true"></span>
          <div><b class="{{ proofb }}">Maintenance comes first</b><span class="{{ proofs }}">Our crowdfunding campaign set care and maintenance as the condition of success, before any shiny stretch goal.</span></div>
        </div>
        <div class="grid grid-cols-[auto_1fr] gap-4">
          <span class="w-[9px] h-[9px] mt-2 bg-flame [clip-path:polygon(50%_0,100%_50%,50%_100%,0_50%)] shadow-[0_0_8px_rgba(245,195,68,.6)]" aria-hidden="true"></span>
          <div><b class="{{ proofb }}">People before releases</b><span class="{{ proofs }}">When life intervenes, the team redistributes tasks and slows down the release cycle. Resilient relationships, not just resilient code.</span></div>
        </div>
        <div class="grid grid-cols-[auto_1fr] gap-4">
          <span class="w-[9px] h-[9px] mt-2 bg-flame [clip-path:polygon(50%_0,100%_50%,50%_100%,0_50%)] shadow-[0_0_8px_rgba(245,195,68,.6)]" aria-hidden="true"></span>
          <div><b class="{{ proofb }}">No one owns us</b><span class="{{ proofs }}">AGPL, super-forkable, no VC, no ads. Nothing to sell, no reason to enshittify.</span></div>
        </div>
      </div>
      <a class="{{ more }}" href="/about">Read the story behind Bonfire →</a>
    </div>
    <div class="relative rounded-xl overflow-hidden border border-ink/15 bg-night-2 min-h-0 aspect-[16/10] min-[821px]:aspect-auto min-[821px]:min-h-[460px] shadow-[0_24px_80px_-30px_rgba(232,145,43,.35),0_6px_30px_-12px_rgba(0,0,0,.7)]">
      <img class="w-full h-full object-cover object-[60%_center]" src="/img/v2/rocco_4.png" alt="Woodcut illustration: a bear walking through a night forest toward a campfire" loading="lazy">
      <div class="absolute inset-0 rounded-xl pointer-events-none shadow-[inset_0_0_0_1px_rgba(255,223,130,.06),inset_0_-60px_90px_-50px_rgba(12,14,21,.8)]" aria-hidden="true"></div>
      <span class="absolute left-3.5 bottom-3 z-[3] badge h-auto rounded font-smono text-[.66rem] tracking-[.12em] text-spark bg-night/70 border-ink/15 px-2.5 py-[5px] backdrop-blur-sm">The long walk toward the fire</span>
    </div>
  </div>
</div></section>
