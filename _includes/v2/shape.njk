{# ============================================================
   V2 · 03 · ACT TWO — SHAPE IT (Tailwind + daisyUI)
   Requires: v2 tokens in css/index.css
   ============================================================ #}
{% set persona = "badge h-auto gap-2 rounded-full bg-transparent border-ink/15 px-3.5 py-[7px] font-smono text-[.68rem] tracking-[.1em] text-ink-2" %}
{% set cell = "card rounded-xl border border-ink/15 bg-gradient-to-b from-night-2 to-night px-[26px] py-7 hover:border-ink/25" %}
{% set cellk = "font-smono text-[.68rem] tracking-[.13em] text-flame" %}
{% set cellh = "font-disp font-[620] text-[1.28rem] mt-3.5 mb-[9px]" %}
{% set cellp = "text-ink-2 text-[.96rem]" %}
{% set more = "inline-flex items-center gap-[9px] mt-[30px] pb-[3px] font-smono text-[.8rem] tracking-[.05em] text-spark border-b border-spark/35 hover:border-spark" %}

<section id="shape" class="py-[clamp(72px,9vw,130px)] border-t border-ink/[0.07] scroll-mt-[70px]">
<div class="max-w-[1140px] mx-auto px-7">
  <p class="flex items-center gap-3 font-smono text-[1rem] font-bold tracking-[.18em] text-flame">Shape it</p>
  <h2 class="mt-[22px] font-disp font-[560] text-[clamp(2rem,4.4vw,3.4rem)] leading-[1.05] text-balance [font-variation-settings:'opsz'_96]">Then, made to fit, <span class="fire-text">by you.</span></h2>
  <p class="mt-5 text-[1.05rem] text-ink-2 max-w-[40rem]">Bonfire is assembled from building blocks, not moulded into a single fixed shape. Include what your community needs, leave out the rest, give it your look and feel, and it becomes a space that's <b class="text-ink font-semibold">unmistakably yours</b>. No two communities end up the same.</p>
  <p class="mt-5 text-[1.05rem] text-ink-2 max-w-[40rem]">Your domain, your name, your look — end to end. Members arrive at <em class="text-flame not-italic">your</em> space, never at "the community tab" on someone else's platform.</p>

  {% set himg = "w-full aspect-video rounded-xl object-cover" %}
  {% set hph = "w-full aspect-video rounded-xl border border-dashed border-ink/15 flex items-center justify-center font-smono text-[.72rem] text-ink-3 bg-[repeating-linear-gradient(135deg,transparent_0_22px,rgba(242,236,219,.025)_22px_44px)]" %}
  {% set hcap = "mt-4 text-[.95rem] text-ink-2 [&_strong]:text-ink [&_strong]:font-semibold" %}
  <div class="grid gap-4 mt-[34px] md:grid-cols-2">
    <figure class="m-0 md:col-span-2">
      <img class="{{ himg }}" src="/img/cafe.png" alt="Woodcut illustration: a bird carrying a burning branch across the night, lighting fires below as it goes" loading="lazy" />
      <figcaption class="{{ hcap }}"><strong>The result.</strong> A home that matches how your community already works, no two end up the same.</figcaption>
    </figure>
    <figure class="m-0">
      <img class="{{ himg }}" src="/img/polls.png" alt="Screenshot: creating a poll in Bonfire" loading="lazy" />
      <figcaption class="{{ hcap }}"><strong>Assemble your building blocks.</strong> Switch features on and off from the settings — groups, events, moderation tools, and more — and the space reshapes itself around them.</figcaption>
    </figure>
    <figure class="m-0">
      <img class="{{ himg }}" src="/img/boundaries.png" alt="Screenshot: setting boundaries on who can see and reply to a post" loading="lazy" />
      <figcaption class="{{ hcap }}"><strong>Start from a preset.</strong> Pick a space that's already close to what you need, then adjust block by block until it fits.</figcaption>
    </figure>
  </div>

  <figure class="mt-10 max-w-[46rem] border-l-2 border-flame/40 pl-5">
    <blockquote class="font-disp text-[1.25rem] leading-[1.4] text-ink text-balance">"Like getting all your friends together for a big barn-raising — and then each of you gets to customise and decorate your own interior unit."</blockquote>
    <figcaption class="mt-2.5 font-smono text-[.72rem] tracking-[.06em] text-ink-3">— a Bonfire community member</figcaption>
  </figure>

  <a class="{{ more }}" href="#cases">No two end up alike, see how different communities made it their own →</a>
</div></section>
