{# ============================================================
   V2 · 03 · ACT TWO — SHAPE IT (Tailwind + daisyUI)
   Requires: v2 tokens in css/index.css
   ============================================================ #}
{% set persona = "badge h-auto gap-2 rounded-full bg-transparent border-ink/15 px-3.5 py-[7px] font-smono text-[.68rem] tracking-[.1em] text-ink-2" %}
{% set cell = "card rounded-xl border border-ink/15 bg-gradient-to-b from-night-2 to-night px-[26px] py-7 hover:border-ink/25" %}
{% set cellk = "font-smono text-[.68rem] tracking-[.13em] text-flame" %}
{% set cellh = "font-disp font-[620] text-[1.28rem] mt-3.5 mb-[9px]" %}
{% set cellp = "text-ink-2 text-[.96rem]" %}
{% set more = "inline-flex items-center gap-[9px] mt-[30px] pb-[3px] font-smono text-[.8rem] tracking-[.05em] text-spark border-b border-spark/35 hover:border-spark" %}

<section id="shape" class="py-[clamp(72px,9vw,130px)] border-t border-ink/[0.07] scroll-mt-[70px]">
<div class="max-w-[1140px] mx-auto px-7">
  <p class="flex items-center gap-3 font-smono text-[1rem] font-bold tracking-[.18em] text-flame">Shape it</p>
  <h2 class="mt-[22px] font-disp font-[560] text-[clamp(2rem,4.4vw,3.4rem)] leading-[1.05] text-balance [font-variation-settings:'opsz'_96]">Then, made to fit, <span class="fire-text">by you.</span></h2>
  <p class="mt-5 text-[1.05rem] text-ink-2 max-w-[40rem]">Bonfire is assembled from building blocks, not moulded into a single fixed shape. Include what your community needs, leave out the rest, give it your look and feel, and it becomes a space that's <b class="text-ink font-semibold">unmistakably yours</b>. No two communities end up the same.</p>

  {% set hcard = "flex-none w-[clamp(320px,90vw,1040px)] snap-start m-0" %}
  {% set himg = "w-full aspect-video rounded-xl border border-dashed border-ink/15 flex items-center justify-center font-smono text-[.72rem] text-ink-3 bg-[repeating-linear-gradient(135deg,transparent_0_22px,rgba(242,236,219,.025)_22px_44px)] pointer-events-none" %}
  {% set hcap = "mt-4 text-[.95rem] text-ink-2 [&_strong]:text-ink [&_strong]:font-semibold" %}
  <div class="flex gap-6 overflow-x-auto pb-5 mt-[34px] snap-x snap-proximity cursor-grab select-none [scrollbar-width:none] [&::-webkit-scrollbar]:hidden [-webkit-overflow-scrolling:touch]" data-hscroll>
    <figure class="{{ hcard }}">
      <img class="{{ himg }}" src="/img/cafe.png" alt="Woodcut illustration: a bird carrying a burning branch across the night, lighting fires below as it goes" loading="lazy" />
      {# <div class="{{ himg }}">IMG · a shaped community home with custom feeds</div> #}
      {# <div class="{{ himg }}">IMG · switching blocks on and off in the admin settings</div> #}
      <figcaption class="{{ hcap }}"><strong>Assmble your building blocks.</strong> Switch features on and off from the settings - groups, events, moderation tools, etc - the space reshapes itself around them.</figcaption>
    </figure>
    <figure class="{{ hcard }}">
      <img class="{{ himg }}" src="/img/boundaries.png" alt="Woodcut illustration: a bird carrying a burning branch across the night, lighting fires below as it goes" loading="lazy" />
      {# <div class="{{ himg }}">IMG · choosing a preset during setup</div> #}
      <figcaption class="{{ hcap }}"><strong>Start half-built.</strong> Presets give you a space that's already close, then adjust block by block until it fits.</figcaption>
    </figure>
    <figure class="{{ hcard }}">
      <div class="{{ himg }}">IMG · theme &amp; branding settings</div>
      <figcaption class="{{ hcap }}"><strong>Make it look like you.</strong> Your name, colours, and language throughout, members see home, not a platform.</figcaption>
    </figure>
    <figure class="{{ hcard }}">
      <div class="{{ himg }}">IMG · a shaped community home with custom feeds</div>
      <figcaption class="{{ hcap }}"><strong>The result.</strong> A home that matches how your community already works, no two end up the same.</figcaption>
    </figure>
  </div>

  <a class="{{ more }}" href="#cases">No two end up alike, see how different communities made it their own →</a>
</div></section>

<script>
(function(){
"use strict";
/* drag-to-scroll for the GUI carousel; snap pauses while dragging */
document.querySelectorAll('[data-hscroll]').forEach(function(s){
  var down=false,startX=0,startLeft=0,moved=0;
  s.addEventListener('pointerdown',function(e){
    down=true;moved=0;startX=e.clientX;startLeft=s.scrollLeft;
    s.classList.add('cursor-grabbing','snap-none');
    try{s.setPointerCapture(e.pointerId);}catch(_){}
  });
  s.addEventListener('pointermove',function(e){
    if(!down)return;
    var dx=e.clientX-startX;moved=Math.abs(dx);
    s.scrollLeft=startLeft-dx;
  });
  function end(){down=false;s.classList.remove('cursor-grabbing','snap-none');}
  s.addEventListener('pointerup',end);
  s.addEventListener('pointercancel',end);
  s.addEventListener('pointerleave',end);
  s.addEventListener('click',function(e){if(moved>6){e.preventDefault();}},true);
});
})();
</script>
