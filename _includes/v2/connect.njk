{# ============================================================
   V2 · 04 · ACT THREE — CONNECT IT (Tailwind + daisyUI)
   Openness cards (local → archipelago → open web) + illustration.
   Requires: v2 tokens in css/index.css.
   ============================================================ #}
{% set persona = "badge h-auto gap-2 rounded-full bg-transparent border-ink/15 px-3.5 py-[7px] font-smono text-[.68rem] tracking-[.1em] text-ink-2" %}
{% set cell = "card rounded-xl border border-ink/15 bg-gradient-to-b from-night-2 to-night px-[26px] py-7 hover:border-corn/40" %}
{% set cellk = "font-smono text-[.68rem] tracking-[.13em] text-corn" %}
{% set cellh = "font-disp font-[620] text-[1.28rem] mt-3.5 mb-[9px]" %}
{% set cellp = "text-ink-2 text-[.96rem]" %}
{% set reach = "badge h-auto gap-[9px] rounded-full bg-transparent border-ink/15 px-[15px] py-2 font-smono text-[.76rem] text-ink-2" %}
{% set more = "inline-flex items-center gap-[9px] mt-[30px] pb-[3px] font-smono text-[.8rem] tracking-[.05em] text-spark border-b border-spark/35 hover:border-spark" %}

<section id="connect" class="py-[clamp(72px,9vw,130px)] border-t border-ink/[0.07] scroll-mt-[70px]">
<div class="max-w-[1140px] mx-auto px-7">
  <p class="flex items-center gap-3 font-smono text-[.72rem] font-bold tracking-[.18em] text-corn">Connect it</p>
  <h2 class="mt-[22px] font-disp font-[560] text-[clamp(2rem,4.4vw,3.4rem)] leading-[1.05] text-balance [font-variation-settings:'opsz'_96]">Then, open to the world, <span class="corn-text">as far as you like.</span></h2>
  <p class="mt-5 text-[1.05rem] text-ink-2 max-w-[40rem]"><b class="text-ink font-semibold">Many interconnected worlds, not one massive platform.</b> From day one your space can be linked to <em class="text-corn-2 not-italic">millions of people</em> across the open social web, so your community doesn't start from scratch. No central power dictates the terms — only independent spaces, connected on their own.</p>
  <p class="mt-5 text-[1.05rem] text-ink-2 max-w-[40rem]">You decide exactly how open or closed to be:</p>

  <div class="grid grid-cols-1 min-[761px]:grid-cols-3 gap-3.5 mt-[34px]">
    <div class="{{ cell }}">
      <span class="{{ cellk }}">01</span>
      <h3 class="{{ cellh }}">Your local community</h3>
      <p class="{{ cellp }}">Invite-only, quiet and warm, a space just for your people. Nobody else joins your bonfire unless you say so.</p>
    </div>
    <div class="{{ cell }}">
      <span class="{{ cellk }}">02</span>
      <h3 class="{{ cellh }}">A trusted archipelago</h3>
      <p class="{{ cellp }}">Connected only with your allies and communities you trust, and form a private interconnected network together <em class="text-corn-2 not-italic">(Archipelago mode)</em>.</p>
      <p class="{{ cellp }} mt-2.5 text-[.85rem] text-ink-3">Co-designed with <a class="underline decoration-ink/25 hover:text-spark" href="https://mentaal.nl" target="_blank" rel="noopener noreferrer">Mentaal</a>, a Dutch mental-health network — they call it &ldquo;the portal to a different kind of internet.&rdquo;</p>
    </div>
    <div class="{{ cell }}">
      <span class="{{ cellk }}">03</span>
      <h3 class="{{ cellh }}">The open web</h3>
      <p class="{{ cellp }}">Follow and be followed across every other Bonfire, Mastodon, PeerTube, etc, <em class="text-corn-2 not-italic">(the fediverse)</em>, with bridges to ATproto/Bluesky and more, so no one is left on the far shore.</p>
    </div>
  </div>

  <img class="block w-full mt-[22px] rounded-xl border border-ink/15" src="/img/archi.png" loading="lazy" alt="Screenshot of Bonfire's Archipelago federation settings, where an instance allowlists the servers and people it federates with">

  <img class="block w-full mt-4 mb-1 rounded-xl" src="/img/3_uncompressed.png" loading="lazy" alt="Woodcut illustration: a bird carrying a burning branch across the night, lighting fires below as it goes">
</div></section>

