{# ============================================================
   V2 · 04 · ACT THREE — CONNECT IT (Tailwind + daisyUI)
   Openness cards (local → archipelago → open web) + illustration.
   Requires: v2 tokens in css/index.css.
   ============================================================ #}
{% set persona = "badge h-auto gap-2 rounded-full bg-transparent border-ink/15 px-3.5 py-[7px] font-smono text-[.68rem] tracking-[.1em] uppercase text-ink-2" %}
{% set cell = "card rounded-xl border border-ink/15 bg-gradient-to-b from-night-2 to-night px-[26px] py-7 hover:border-corn/40" %}
{% set cellk = "font-smono text-[.68rem] tracking-[.13em] uppercase text-corn" %}
{% set cellh = "font-disp font-[620] text-[1.28rem] mt-3.5 mb-[9px]" %}
{% set cellp = "text-ink-2 text-[.96rem]" %}
{% set reach = "badge h-auto gap-[9px] rounded-full bg-transparent border-ink/15 px-[15px] py-2 font-smono text-[.76rem] text-ink-2" %}
{% set more = "inline-flex items-center gap-[9px] mt-[30px] pb-[3px] font-smono text-[.8rem] tracking-[.05em] uppercase text-spark border-b border-spark/35 hover:border-spark" %}

<section id="connect" class="py-[clamp(72px,9vw,130px)] border-t border-ink/[0.07] scroll-mt-[70px]">
<div class="max-w-[1140px] mx-auto px-7">
  <p class="flex items-center gap-3 font-smono text-[.72rem] font-bold tracking-[.18em] uppercase text-corn">Connect it</p>
  <h2 class="mt-[22px] font-disp font-[560] text-[clamp(2rem,4.4vw,3.4rem)] leading-[1.05] text-balance [font-variation-settings:'opsz'_96]">Then, open to the world, <span class="corn-text">as far as you like.</span></h2>
  <p class="mt-5 text-[1.05rem] text-ink-2 max-w-[40rem]">Your space is never an island. From day one it's linked to <em class="text-corn-2 not-italic">millions of people</em> across the open social web, so your community never starts from zero. You decide exactly how open or closed to be.</p>

  <div class="grid grid-cols-1 min-[761px]:grid-cols-3 gap-3.5 mt-[34px]">
    <div class="{{ cell }}">
      <span class="{{ cellk }}">01</span>
      <h3 class="{{ cellh }}">Your local community</h3>
      <p class="{{ cellp }}">Invite-only, quiet and warm — a space just for your people. Nothing leaves the hearth unless you say so.</p>
    </div>
    <div class="{{ cell }}">
      <span class="{{ cellk }}">02</span>
      <h3 class="{{ cellh }}">A trusted archipelago</h3>
      <p class="{{ cellp }}">Link arms with communities you vouch for — a private network you form together <em class="text-corn-2 not-italic">(Archipelago)</em>.</p>
    </div>
    <div class="{{ cell }}">
      <span class="{{ cellk }}">03</span>
      <h3 class="{{ cellh }}">The open web</h3>
      <p class="{{ cellp }}">Follow and be followed across Mastodon, PeerTube &amp; every other Bonfire <em class="text-corn-2 not-italic">(the fediverse)</em> — with bridges to Bluesky &amp; Matrix, so no one is left on the far shore.</p>
    </div>
  </div>

  <img class="block w-full mt-[22px] mb-1 rounded-xl" src="/img/3_uncompressed.png" loading="lazy" alt="Woodcut illustration: a bird carrying a burning branch across the night, lighting fires below as it goes">
</div></section>

