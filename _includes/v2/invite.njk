{# ============================================================
   V2 · 08 · THE DOOR IS OPEN — closing invite (Tailwind + daisyUI)
   Requires: v2 tokens in css/index.css. This is the #join target
   the header CTA points at.
   ============================================================ #}
{% set secondary = "text-ink-2 border-b border-ink/15 pb-0.5 hover:text-spark hover:border-spark" %}

<section id="join" class="text-center pt-[clamp(72px,9vw,130px)] pb-[clamp(90px,10vw,150px)] border-t border-ink/[0.07] scroll-mt-[70px]">
<div class="max-w-[1140px] mx-auto px-7">
  <p class="flex items-center justify-center gap-3 font-smono text-[1rem] font-bold tracking-[.18em] uppercase text-ink-3">The door is open</p>
  <h2 class="mt-6 mx-auto max-w-[17ch] font-disp font-[560] text-[clamp(2.4rem,5.4vw,4.4rem)] leading-[1.05] text-balance [font-variation-settings:'opsz'_96]">Bring your people <span class="fire-text">home.</span></h2>
  <div class="flex flex-wrap justify-center gap-3.5 mt-[38px]">
    <a class="btn h-auto min-h-0 rounded-full border-0 px-6 py-[.9rem] font-smono text-[.82rem] font-bold uppercase tracking-[.05em] text-[#221302] bg-gradient-to-br from-spark via-flame to-ember hover:from-spark hover:via-flame hover:to-ember shadow-[0_6px_26px_-8px_rgba(232,145,43,.55)]" href="/start">Launch your community</a>
  </div>
  <div class="flex flex-wrap justify-center gap-6 mt-[26px] font-smono text-[.8rem] text-ink-3">
    <a class="{{ secondary }}" href="https://campground.bonfire.cafe" target="_blank" rel="noopener noreferrer">Wander the demo</a>
    <a class="{{ secondary }}" href="/community">Co-design it with us</a>
    <a class="{{ secondary }}" href="/contact">Talk to a human</a>
  </div>
  <p class="mt-[26px] font-smono text-[.82rem] text-ink-3">We're not looking for users. We're looking for <em class="text-spark italic">participants</em>.</p>
</div></section>
