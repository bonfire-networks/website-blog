{% set offsets = ["mt-0", "mt-9", "mt-3", "mt-12", "mt-5"] %}
{% set tones = ["#51372f", "#303b68", "#38482d", "#68451d", "#5d3028"] %}
{% set floatDurations = ["22s", "29s", "19s", "32s", "25s"] %}
{% set floatDelays = ["-4s", "-17s", "-9s", "-23s", "-13s"] %}
{% set floatRanges = ["7px", "11px", "8px", "12px", "9px"] %}

<style>
  @keyframes community-card-drift {
    from { transform: translate3d(0, calc(var(--float-range) * -1), 0); }
    to { transform: translate3d(0, var(--float-range), 0); }
  }

  #story .community-case-card {
    animation: community-card-drift var(--float-duration) ease-in-out var(--float-delay) infinite alternate;
    backface-visibility: hidden;
    will-change: transform;
  }

  #story .community-case-image {
    transform: translate3d(0, 0, 0) scale(1.001);
    transform-origin: 50% 45%;
    backface-visibility: hidden;
    transition: transform 1400ms cubic-bezier(.37, 0, .63, 1);
    will-change: transform;
  }

  #story .community-case-card:hover,
  #story .community-case-card:focus-visible {
    animation-play-state: paused;
  }

  #story .community-case-card:hover .community-case-image,
  #story .community-case-card:focus-visible .community-case-image {
    transform: translate3d(0, 0, 0) scale(1.065);
  }

  #story.is-motion-paused .community-case-card,
  #story.is-offscreen .community-case-card {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    #story .community-case-card {
      animation: none;
    }

    #story .community-case-image {
      transform: none;
      transition: none;
    }
  }
</style>

<section
  id="story"
  class="border-t border-ink/[0.07] py-[clamp(72px,9vw,130px)] scroll-mt-[70px]"
>
  <div class="mx-auto max-w-[1140px] px-7">
    <div class="grid items-end gap-8 min-[821px]:grid-cols-[minmax(0,1fr)_19rem]">
      <div>
        <p class="font-disp text-[1rem] font-bold tracking-[.08em] text-flame">Find a community like yours</p>
        <h2 class="mt-[18px] max-w-[20ch] text-balance font-disp text-[clamp(2.25rem,5vw,4.2rem)] font-[560] leading-[1.01] [font-variation-settings:'opsz'_96]">
          The same Bonfire, in <span class="fire-text">many different hands.</span>
        </h2>
      </div>
      {# <div class="flex items-center gap-2 min-[821px]:justify-end" aria-label="Community examples carousel controls">
        <button
          class="grid h-11 w-11 place-items-center rounded-full border border-ink/15 text-lg text-ink-2 transition-colors hover:border-ink/30 hover:bg-ink/[0.05] hover:text-ink"
          type="button"
          aria-label="Previous community examples"
          data-community-scroll="-390"
        >
          <i class="ph ph-caret-left" aria-hidden="true"></i>
        </button>
        <button
          class="grid h-11 w-11 place-items-center rounded-full border border-ink/15 text-lg text-ink-2 transition-colors hover:border-ink/30 hover:bg-ink/[0.05] hover:text-ink"
          type="button"
          aria-label="Pause card motion"
          aria-pressed="false"
          data-community-toggle
        >
          <i class="ph ph-pause" data-community-pause-icon aria-hidden="true"></i>
          <i class="ph ph-play hidden" data-community-play-icon aria-hidden="true"></i>
        </button>
        <button
          class="grid h-11 w-11 place-items-center rounded-full border border-ink/15 text-lg text-ink-2 transition-colors hover:border-ink/30 hover:bg-ink/[0.05] hover:text-ink"
          type="button"
          aria-label="Next community examples"
          data-community-scroll="390"
        >
          <i class="ph ph-caret-right" aria-hidden="true"></i>
        </button>
      </div> #}
      {# <div class="flex items-end justify-between gap-5 min-[821px]:block">
        <p class="m-0 max-w-[36ch] text-[1rem] leading-[1.6] text-ink-2">
          From publications to neighbourhoods, each community combines the building blocks it needs and makes the space its own.
        </p>
        <div class="mt-6 flex shrink-0 gap-2 min-[821px]:justify-end" aria-label="Community examples carousel controls">
          <button
            class="grid h-11 w-11 place-items-center rounded-full border border-ink/15 text-lg text-ink-2 transition-colors hover:border-ink/30 hover:bg-ink/[0.05] hover:text-ink"
            type="button"
            aria-label="Previous community examples"
            data-community-scroll="-390"
          >
            <i class="ph ph-caret-left" aria-hidden="true"></i>
          </button>
          <button
            class="grid h-11 w-11 place-items-center rounded-full border border-ink/15 text-lg text-ink-2 transition-colors hover:border-ink/30 hover:bg-ink/[0.05] hover:text-ink"
            type="button"
            aria-label="Next community examples"
            data-community-scroll="390"
          >
            <i class="ph ph-caret-right" aria-hidden="true"></i>
          </button>
        </div>
      </div> #}
    </div>
  </div>

  <div
    class="mt-[clamp(34px,5vw,58px)] flex items-start gap-4 overflow-x-auto px-8 pb-6 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    style="scroll-padding-inline:32px"
    data-community-rail
    role="region"
    aria-label="Community case studies and example configurations"
  >
    {% for r in recipes %}
    <a
      class="community-case-card group relative isolate flex h-[570px] w-[min(82vw,350px)] shrink-0 snap-start overflow-hidden rounded-xl bg-night-2 min-[681px]:h-[620px] min-[681px]:w-[365px] {{ offsets[loop.index0] }}"
      style="--acc:{{ r.acc }};--tone:{{ tones[loop.index0] }};--float-duration:{{ floatDurations[loop.index0] }};--float-delay:{{ floatDelays[loop.index0] }};--float-range:{{ floatRanges[loop.index0] }}"
      href="{{ r.link or '/features' }}"
      {% if r.link and '//' in r.link %}target="_blank" rel="noopener noreferrer"{% endif %}
      aria-labelledby="recipe-title-{{ r.id }}"
      aria-describedby="recipe-meta-{{ r.id }} recipe-outcome-{{ r.id }} recipe-blocks-{{ r.id }}"
    >
      <img
        class="community-case-image absolute inset-0 h-full w-full object-cover saturate-[.82]"
        src="/img/v2/recipes/{{ r.img }}"
        alt=""
        style="object-position:{{ r.imagepos }}"
        loading="lazy"
      >
      <span
        class="absolute inset-0"
        style="background:linear-gradient(180deg,transparent 10%,color-mix(in srgb,var(--tone) 20%,transparent) 34%,color-mix(in srgb,var(--tone) 92%,transparent) 58%,var(--tone) 100%)"
        aria-hidden="true"
      ></span>
      <span class="absolute inset-x-0 bottom-0 h-1/2 opacity-[.13] mix-blend-soft-light" style="background:var(--acc)" aria-hidden="true"></span>

      <div class="relative mt-auto flex w-full flex-col p-5 min-[681px]:p-6">
        <div
          id="recipe-meta-{{ r.id }}"
          class="flex w-fit max-w-full items-center gap-2.5 rounded-xl border border-ink/15 bg-night/55 py-2 pl-2 pr-3.5 shadow-[0_12px_32px_-18px_rgba(0,0,0,.9)] backdrop-blur-md"
        >
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-ink text-lg text-night" aria-hidden="true">
            <i class="ph-duotone {{ r.icons[0] }}"></i>
          </span>
          <span class="min-w-0">
            <span class="block truncate text-[.68rem] font-[620] uppercase tracking-[.045em] text-ink/65">{{ r.exampletype }}</span>
            <span class="block truncate font-disp text-[.92rem] font-[650] text-ink">{{ r.example }}</span>
          </span>
        </div>

        <p class="mt-5 text-[.76rem] font-[620] text-[var(--acc)]">{{ r.kind }}</p>
        <h3 id="recipe-title-{{ r.id }}" class="mt-2 text-balance font-disp text-[1.65rem] font-[620] leading-[1.05]">{{ r.title }}</h3>
        <p id="recipe-outcome-{{ r.id }}" class="mt-3 text-[.88rem] leading-[1.48] text-ink/80">{{ r.becomes }}</p>

        {# <div id="recipe-blocks-{{ r.id }}" class="mt-4 flex flex-wrap gap-1.5" aria-label="Selected Bonfire building blocks">
          {% for item in r.items %}
            {% if loop.index <= 3 and not item.soon %}
            <span class="rounded-full bg-night/35 px-2.5 py-[5px] text-[.75rem] leading-none text-ink/85">{{ item.t }}</span>
            {% endif %}
          {% endfor %}
        </div> #}

        <span class="mt-5 inline-flex items-center gap-2 text-[.78rem] font-[620] text-ink">
          {{ r.linklabel or "Explore these building blocks" }}
          <span class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
        </span>
      </div>
    </a>
    {% endfor %}

    <a
      class="community-case-card mt-10 flex h-[540px] w-[min(82vw,330px)] shrink-0 snap-start flex-col items-center justify-center rounded-xl border border-dashed border-ink/20 px-8 text-center min-[681px]:h-[580px] min-[681px]:w-[340px]"
      style="--float-duration:27s;--float-delay:-18s;--float-range:10px"
      href="/features"
    >
      <span class="grid h-12 w-12 place-items-center rounded-full border border-ink/20 text-xl text-flame" aria-hidden="true">+</span>
      <h3 class="mt-5 max-w-[12ch] text-balance font-disp text-[1.65rem] font-[620] leading-[1.08]">A union, a co-op, a school—or yours.</h3>
      <p class="mt-3 max-w-[26ch] text-[.88rem] leading-[1.5] text-ink-3">Every community can write a different recipe from the same open building blocks.</p>
      <span class="mt-6 border-b border-spark/35 pb-1 text-[.78rem] font-[620] text-spark">Browse all building blocks →</span>
    </a>
  </div>

  <div class="mx-auto max-w-[1140px] px-7">
    <div class="mt-[clamp(48px,7vw,78px)] border-t border-ink/[0.09] pt-7">
      <div class="grid gap-5 min-[821px]:grid-cols-[17rem_minmax(0,1fr)] min-[821px]:items-start">
        <div>
          <p class="font-disp text-[1.05rem] font-[620]">Every space takes shape in three acts.</p>
          <p class="mt-2 text-[.86rem] leading-[1.5] text-ink-3">The community stays the author at every step.</p>
        </div>
        <ol class="grid gap-5 min-[681px]:grid-cols-3">
          <li>
            <a class="group block" href="#gather">
              <span class="text-[.7rem] font-[620] text-flame">01 · GATHER</span>
              <strong class="mt-2 block font-disp text-[1.2rem] font-[620] group-hover:text-spark">Claim your space</strong>
              <span class="mt-1 block text-[.84rem] leading-[1.5] text-ink-3">A home that is truly yours to govern.</span>
            </a>
          </li>
          <li>
            <a class="group block" href="#shape">
              <span class="text-[.7rem] font-[620] text-flame">02 · SHAPE IT</span>
              <strong class="mt-2 block font-disp text-[1.2rem] font-[620] group-hover:text-spark">Choose the blocks</strong>
              <span class="mt-1 block text-[.84rem] leading-[1.5] text-ink-3">Fit the tools to how your community works.</span>
            </a>
          </li>
          <li>
            <a class="group block" href="#connect">
              <span class="text-[.7rem] font-[620] text-flame">03 · CONNECT</span>
              <strong class="mt-2 block font-disp text-[1.2rem] font-[620] group-hover:text-spark">Open the doors</strong>
              <span class="mt-1 block text-[.84rem] leading-[1.5] text-ink-3">Connect to communities or the whole social web.</span>
            </a>
          </li>
        </ol>
      </div>
    </div>
  </div>

  <script>
    (() => {
      const section = document.currentScript.closest("#story");
      const rail = section?.querySelector("[data-community-rail]");
      if (!rail) return;

      let userPaused = false;

      section.querySelectorAll("[data-community-scroll]").forEach((button) => {
        button.addEventListener("click", () => {
          rail.scrollBy({
            left: Number(button.dataset.communityScroll),
            behavior: "smooth"
          });
        });
      });

      const toggle = section.querySelector("[data-community-toggle]");
      const pauseIcon = toggle?.querySelector("[data-community-pause-icon]");
      const playIcon = toggle?.querySelector("[data-community-play-icon]");
      toggle?.addEventListener("click", () => {
        userPaused = !userPaused;
        section.classList.toggle("is-motion-paused", userPaused);
        toggle.setAttribute("aria-pressed", String(userPaused));
        toggle.setAttribute("aria-label", userPaused ? "Resume card motion" : "Pause card motion");
        pauseIcon?.classList.toggle("hidden", userPaused);
        playIcon?.classList.toggle("hidden", !userPaused);
      });

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reducedMotion) {
        toggle?.setAttribute("hidden", "");
        return;
      }

      const visibilityObserver = new IntersectionObserver(([entry]) => {
        section.classList.toggle("is-offscreen", !entry.isIntersecting);
      }, { threshold: 0.04 });

      visibilityObserver.observe(section);
    })();
  </script>
</section>
