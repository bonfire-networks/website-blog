  {
    id: "festival",
    acc: "var(--color-ember)",
    kind: "Festival",
    tabline: "Keep the crowd beyond the event",
    title: "A festival becomes a community that outlasts the weekend.",
    img: "festival-card.webp",
    imagepos: "center 58%",
    example: "Festival",
    exampletype: "Example configuration",
    starts: "Artists, organisers and audiences gathering around a temporary event.",
