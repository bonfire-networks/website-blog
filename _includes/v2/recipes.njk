{# ============================================================
   V2 · COMMUNITY FIT EXPLORER
   A role-first, master-detail alternative to the recipe grid.
   The equation makes Bonfire's mechanism explicit:
   community context + chosen blocks = a world of its own.
   ============================================================ #}
{% set recipes = [
  {
    id: "magazine",
    acc: "#e6dab6",
    kind: "Publication",
    tabline: "Turn readers into members",
    title: "A magazine becomes a community under its own masthead.",
