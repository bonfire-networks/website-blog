{% set rk = "font-smono text-[13px] tracking-[.13em] text-[var(--acc)]" %}
{% set tilebase = "w-[60px] h-[60px] rounded-2xl flex items-center justify-center text-3xl -mx-2.5 text-[var(--acc)] border border-[color-mix(in_srgb,var(--acc)_38%,transparent)] bg-[linear-gradient(160deg,color-mix(in_srgb,var(--acc)_20%,var(--color-night-3)),color-mix(in_srgb,var(--acc)_6%,var(--color-night)))] shadow-[0_14px_28px_-14px_rgba(0,0,0,.85),inset_0_1px_0_color-mix(in_srgb,var(--acc)_25%,transparent)] transition-all duration-[350ms] ease-[cubic-bezier(.22,.8,.3,1)] group-hover:rotate-0 group-hover:translate-y-0 group-hover:mx-1.5 group-hover:shadow-[0_18px_34px_-14px_color-mix(in_srgb,var(--acc)_45%,transparent)]" %}
{% set tilepos = ["-rotate-[14deg] translate-y-3 delay-0", "-rotate-[5deg] translate-y-[1px] delay-[30ms]", "rotate-[5deg] translate-y-[1px] delay-[60ms]", "rotate-[14deg] translate-y-3 delay-[90ms]"] %}
{% set ri = "inline-flex items-center rounded-full border border-ink/15 bg-ink/[0.03] px-2.5 py-[4px] text-[.76rem] leading-none text-ink-2 before:content-['+'] before:mr-1 before:font-smono before:font-bold before:text-[var(--acc)]" %}
{% set ribase = "inline-flex items-center rounded-full px-2.5 py-[4px] text-[.76rem] leading-none text-ink border border-[color-mix(in_srgb,var(--acc)_45%,transparent)] bg-[color-mix(in_srgb,var(--acc)_14%,transparent)] before:content-['◆'] before:mr-1.5 before:text-[.5rem] before:text-[var(--acc)]" %}
{% set actlabel = "font-smono text-[.68rem] tracking-[.14em] text-ink-3" %}

{% set recipes = [
  { acc: "var(--color-flame)", kind: "Fablab", img: "fablab.jpg",
    icons: ["ph-toolbox", "ph-cube", "ph-calendar-check", "ph-users-three"],
    items: ["Groups", "Tasks & projects", "Events & workshops", "Equipment bookings"],
    becomes: "One space where members reserve machines, run workshops and document their builds — instead of scattered chats and booking sheets. Yours to govern, open to the makers you choose." },
  { acc: "var(--color-corn)", kind: "A research network", img: "research.jpg",
    icons: ["ph-flask", "ph-article", "ph-kanban", "ph-database"],
    items: ["Scholarly data", "Topics & long-form", "Tasks & events", "Groups"],
    becomes: "Discussion, datasets and preprints in one place — where everyday exchange becomes open, citable research. Connect your lab to the wider commons without handing your work to a publisher." },
  { acc: "var(--color-leaf)", kind: "A neighbourhood", img: "municipality.jpg",
    icons: ["ph-house-line", "ph-confetti", "ph-hand-heart", "ph-megaphone"],
    items: ["Events", "Mutual aid", "Topics & noticeboard", "Places & reviews"],
    becomes: "A local square residents actually run: post notices, organise events, coordinate mutual aid and decide together — no council gatekeeper, no data broker, just your neighbourhood online." },
  { acc: "var(--color-ember)", kind: "A festival", img: "festival.jpg",
    icons: ["ph-ticket", "ph-music-notes", "ph-map-pin", "ph-camera"],
    items: ["Events", "Groups", "Live stream integration", "Living archive"],
    becomes: "Rally the crowd before the gates open, keep them together through every set, then let it all settle into a living archive — one home for your audience that outlasts the weekend." },
  { acc: "#e6dab6", kind: "A magazine", img: "magazine.jpg",
    icons: ["ph-newspaper", "ph-quotes", "ph-chats-circle", "ph-paper-plane-tilt"],
    items: ["Topics & long-form", "Embedded commenting", "Polls", "CMS integration"],
    becomes: "Turn readers into members who debate, subscribe and belong — under your masthead, not a platform's. A community you own, instead of an audience you rent from an algorithm." }
] %}

<section id="story" class="py-[clamp(72px,9vw,130px)] border-t border-ink/[0.07] scroll-mt-[70px]">
<div class="max-w-[1140px] mx-auto px-7">
  <div class="grid grid-cols-1 min-[681px]:grid-cols-[auto_1fr] gap-3.5 min-[681px]:gap-[30px] items-start">
    <div>
      <h2 class="mt-[22px] max-w-[24ch] font-disp font-[560] text-[clamp(2rem,4.4vw,3.4rem)] leading-[1.05] text-balance [font-variation-settings:'opsz'_96]">Shared building blocks to create <span class="fire-text">many different worlds.</span></h2>
      <p class="mt-5 text-[1.05rem] text-ink-2 max-w-[40rem]">There's no single "Bonfire app". Every community designs its own space, assembling the building blocks it needs. No two spaces end up alike.</p>

      {# recipe cards #}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-9">
        {% for r in recipes %}
        <div class="group card overflow-hidden rounded-xl border border-ink/15 bg-gradient-to-b from-night-2 to-night p-0 gap-0" style="--acc:{{ r.acc }}">
          {# image header #}
          <div class="relative h-[190px] overflow-hidden bg-[color-mix(in_srgb,var(--acc)_16%,var(--color-night-3))]" aria-hidden="true">
            <img src="/img/v2/recipes/{{ r.img }}" alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover grayscale-[.4] contrast-[1.05] brightness-[.82] transition-all duration-[600ms] ease-[cubic-bezier(.22,.8,.3,1)] group-hover:scale-[1.045] group-hover:grayscale-[.1] group-hover:brightness-90">
            <span class="absolute inset-0 bg-[var(--acc)] mix-blend-overlay opacity-[.35]"></span>
            <span class="absolute inset-0 bg-gradient-to-t from-night-2 via-night-2/45 via-40% to-transparent"></span>
            <div class="absolute left-5 right-5 bottom-3.5">
              <span class="{{ rk }} drop-shadow-[0_1px_6px_rgba(0,0,0,.9)]">{{ r.kind }}</span>
            </div>
          </div>
          {# body #}
          <div class="flex flex-1 flex-col px-5 pt-[18px] pb-[22px] gap-4">
            <div class="flex justify-center items-end pt-1 pb-1" aria-hidden="true">
              {%- for icon in r.icons %}<span class="{{ tilebase }} {{ tilepos[loop.index0] }}"><i class="ph-duotone {{ icon }}"></i></span>{% endfor -%}
            </div>
            <div class="flex flex-col gap-2.5">
              <span class="font-smono text-[.62rem] tracking-[.13em] text-ink-3">It includes</span>
              <div class="flex flex-wrap gap-1.5">
                <span class="{{ ribase }}">Bonfire Social</span>
                {%- for item in r.items %}<span class="{{ ri }}">{{ item }}</span>{% endfor -%}
              </div>
            </div>
            <p class="mt-auto pt-[15px] text-balance">
              <span class="text-[1.06rem] text-ink leading-[1.42]">{{ r.becomes }}</span>
            </p>
          </div>
        </div>
        {% endfor %}
        {# ghost card #}
        <div class="card rounded-xl border border-dashed border-ink/15 items-center justify-center text-center gap-2.5 px-6 py-[34px]">
          <span class="w-[46px] h-[46px] rounded-xl border border-dashed border-ink/15 flex items-center justify-center font-disp font-light text-[1.7rem] text-ink-3">+</span>
          <h3 class="font-disp font-[620] text-[1.25rem] max-w-[16ch]">…and every community after these</h3>
          <p class="text-ink-3 text-[.9rem] max-w-[26ch]">A union, a co-op, a fan club, a school: each writes its own recipe from the same blocks.</p>
          <a class="mt-1 pb-0.5 font-smono text-[.7rem] tracking-[.06em] text-spark border-b border-spark/35 hover:border-spark" href="/features">Browse all the blocks →</a>
        </div>
      </div>

      {# three-acts bridge #}
      <p class="mt-11 text-[1.05rem] text-ink-2 max-w-[40rem]">How does a space become yours? The story has three acts:</p>
      <div class="grid grid-cols-1 min-[681px]:grid-cols-3 gap-3.5 mt-[18px]">
        <a class="card relative overflow-hidden rounded-xl border border-ink/15 bg-gradient-to-b from-night-2 to-night px-6 pt-[26px] pb-6 hover:border-flame/40" href="#gather">
          <span class="absolute right-[18px] top-3.5 font-disp font-light text-[2.2rem] leading-none text-flame/20" aria-hidden="true">i</span>
          <div class="{{ actlabel }}">Act one</div>
          <h3 class="font-disp font-[620] text-[1.35rem] mt-3 mb-[7px]">Gather</h3>
          <p class="text-ink-2 text-[.93rem] leading-normal">Claim a space that's truly yours to govern.</p>
        </a>
        <a class="card relative overflow-hidden rounded-xl border border-ink/15 bg-gradient-to-b from-night-2 to-night px-6 pt-[26px] pb-6 hover:border-flame/40" href="#shape">
          <span class="absolute right-[18px] top-3.5 font-disp font-light text-[2.2rem] leading-none text-flame/20" aria-hidden="true">ii</span>
          <div class="{{ actlabel }}">Act two</div>
          <h3 class="font-disp font-[620] text-[1.35rem] mt-3 mb-[7px]">Shape it</h3>
          <p class="text-ink-2 text-[.93rem] leading-normal">Make it fit how your community actually works.</p>
        </a>
        <a class="card relative overflow-hidden rounded-xl border border-ink/15 bg-gradient-to-b from-night-2 to-night px-6 pt-[26px] pb-6 hover:border-flame/40" href="#connect">
          <span class="absolute right-[18px] top-3.5 font-disp font-light text-[2.2rem] leading-none text-flame/20" aria-hidden="true">iii</span>
          <div class="{{ actlabel }}">Act three</div>
          <h3 class="font-disp font-[620] text-[1.35rem] mt-3 mb-[7px]">Connect</h3>
          <p class="text-ink-2 text-[.93rem] leading-normal">Open the doors to other communities or the whole social web, your call.</p>
        </a>
      </div>
    </div>
  </div>
</div></section>
