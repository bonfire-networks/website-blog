{# ============================================================
   V2 · 02 · ACT ONE — Gather (Tailwind + daisyUI)
   Requires: v2 tokens in css/index.css
   ============================================================ #}
{% set persona = "badge h-auto gap-2 rounded-full bg-transparent border-ink/15 px-3.5 py-[7px] font-smono text-[.68rem] tracking-[.1em] text-ink-2" %}
{# each card sets --acc (flame or corn); the icon chip, label and hover tints
   all read it, so both variants share one class list #}
{% set cell = "group card rounded-xl border border-ink/15 bg-gradient-to-b from-night-2 to-night px-[26px] py-7 hover:border-ink/25" %}
{% set ic = "w-[42px] h-[42px] rounded-[11px] mb-[15px] flex items-center justify-center text-[22px] text-[var(--acc)] bg-[color-mix(in_srgb,var(--acc)_7%,transparent)] border border-[color-mix(in_srgb,var(--acc)_24%,transparent)] transition-all duration-[250ms] ease-[cubic-bezier(.22,.8,.3,1)] group-hover:-translate-y-0.5 group-hover:bg-[color-mix(in_srgb,var(--acc)_13%,transparent)]" %}
{% set cellk = "font-smono text-[.68rem] tracking-[.13em] text-[var(--acc)]" %}
{% set cellh = "font-disp font-[620] text-[1.28rem] mt-3.5 mb-[9px]" %}
{% set cellp = "text-ink-2 text-[.96rem]" %}
{% set more = "inline-flex items-center gap-[9px] mt-[30px] pb-[3px] font-smono text-[.8rem] tracking-[.05em] text-spark border-b border-spark/35 hover:border-spark" %}

<section id="gather" class="py-[clamp(72px,9vw,130px)] border-t border-ink/[0.07] scroll-mt-[70px]">
<div class="max-w-[1140px] mx-auto px-7">
  <p class="flex items-center gap-3 font-smono text-[1rem] font-bold tracking-[.18em] text-flame">Gather</p>
  <h2 class="mt-[22px] font-disp font-[560] text-[clamp(2rem,4.4vw,3.4rem)] leading-[1.05] text-balance [font-variation-settings:'opsz'_96]">First, a place that's <span class="fire-text">truly yours.</span></h2>
  <p class="mt-5 text-[1.05rem] text-ink-2 max-w-[40rem]">From day one, you set the rules, who joins, who sees what, who decides. No mysterious algorithm ranking your people, no landlord who can sell the building. And if you ever want to move, you take everything with you.</p>

  <div class="grid grid-cols-1 min-[761px]:grid-cols-2 gap-3.5 mt-[34px]">
    <div class="{{ cell }}" style="--acc:var(--color-flame)">
      <span class="{{ ic }}" aria-hidden="true"><i class="ph-duotone ph-scales"></i></span>
      <span class="{{ cellk }}">Decide together</span>
      <h3 class="{{ cellh }}">Govern, your way</h3>
      <p class="{{ cellp }}">Custom roles, shared profiles, and consent-based tools. Distribute power to match how your community really makes decisions.</p>
    </div>
    <div class="{{ cell }}" style="--acc:var(--color-corn)">
      <span class="{{ ic }}" aria-hidden="true"><i class="ph-duotone ph-shield-check"></i></span>
      <span class="{{ cellk }}">Safety without burnout</span>
      <h3 class="{{ cellh }}">Hold the line, together</h3>
      <p class="{{ cellp }}">Circles and boundaries decide who can see and reply; shared blocklists and moderation tools spread the load, so no one carries it alone.</p>
    </div>
    <div class="{{ cell }}" style="--acc:var(--color-flame)">
      <span class="{{ ic }}" aria-hidden="true"><i class="ph-duotone ph-export"></i></span>
      <span class="{{ cellk }}">Anti-enshittifiable: no lock-in</span>
      <h3 class="{{ cellh }}">Take everything with you</h3>
      <p class="{{ cellp }}">Import and export all your data: posts, relationships, settings. A space can't be turned against its people when everyone is free to leave with everything.</p>
    </div>
    <div class="{{ cell }}" style="--acc:var(--color-corn)">
      <span class="{{ ic }}" aria-hidden="true"><i class="ph-duotone ph-sliders-horizontal"></i></span>
      <span class="{{ cellk }}">Shining a light on the power of defaults</span>
      <h3 class="{{ cellh }}">Defaults, not dictates</h3>
      <p class="{{ cellp }}">Admins define the defaults; every member can see exactly how the instance is configured, and override settings for themselves.</p>
    </div>
  </div>

  <!-- <a class="{{ more }}" href="#peek">See governance &amp; safety in the app →</a> -->
</div></section>
