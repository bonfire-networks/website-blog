{# V2 footer — mirrors the current header's information architecture. #}
{% set ftitle = "mb-3 font-smono text-[.68rem] font-bold tracking-[.13em] text-ink-3" %}
{% set flink = "text-[.92rem] leading-6 text-ink-2 transition-colors hover:text-spark focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-flame/70" %}

<div class="bg-night text-ink font-body border-t border-ink/[0.07]">
  <section class="border-b border-ink/[0.07]" aria-labelledby="supporters-heading">
    {% if page.url == "/" %}
    <div class="mx-auto max-w-[1140px] px-7 py-10">
      <h2 id="supporters-heading" class="mx-auto max-w-[760px] text-center font-disp text-[clamp(1.45rem,3vw,2.15rem)] font-[560] leading-[1.15] text-balance">
        Supported by organisations who believe in community-owned digital infrastructure
      </h2>
      <div class="mx-auto mt-7 grid max-w-[780px] gap-4 sm:grid-cols-2">
        <a
          class="group flex min-h-[112px] items-center gap-4 rounded-xl border border-ink/15 bg-night-2 px-5 py-4 text-ink transition-colors hover:border-flame/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-flame/70"
          href="{{ commonsSponsor.url }}"
          rel="sponsored"
        >
          <img
            class="h-[72px] w-[72px] flex-none rounded-[22%] object-contain"
            src="{{ commonsSponsor.logo }}"
            alt="{{ commonsSponsor.alt }}"
            width="512"
            height="512"
            loading="lazy"
          >
          <span>
            <span class="block font-smono text-[.62rem] font-bold uppercase tracking-[.13em] text-ink-3">{{ commonsSponsor.tier }}</span>
            <span class="mt-1.5 block font-disp text-[1.12rem] font-[620] leading-tight transition-colors group-hover:text-spark">{{ commonsSponsor.displayName }}</span>
          </span>
        </a>

        <a
          class="group flex min-h-[112px] items-center justify-center gap-5 rounded-xl border border-ink/15 bg-night-2 px-5 py-4 text-ink transition-colors hover:border-flame/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-flame/70 sm:justify-start"
          href="https://nlnet.nl"
        >
          <span>
            <img src="/img/b-nlnet.png" alt="NLnet" width="140" loading="lazy" class="light-img">
            <img src="/img/w-nlnet.png" alt="NLnet" width="140" loading="lazy" class="dark-img hidden">
          </span>
        </a>
      </div>
    </div>
    {% else %}
    <div class="mx-auto flex items-center justify-center px-7 py-8">
      <div class="flex items-center gap-3">
        <h2 id="supporters-heading" class="text-ink-3">Supported by</h2>
        <a class="ml-4" href="https://nlnet.nl">
          <img src="/img/b-nlnet.png" alt="NLnet" width="140" loading="lazy" class="light-img">
          <img src="/img/w-nlnet.png" alt="NLnet" width="140" loading="lazy" class="dark-img hidden">
        </a>
      </div>
    </div>
    {% endif %}
  </section>

  <div class="mx-auto flex flex-col gap-5 px-7 py-7 sm:flex-row sm:items-center sm:justify-between">
    <a class="group flex items-center gap-3 text-ink focus-visible:rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-flame/70" href="/" aria-label="Bonfire Networks — home">
      <span class="block h-10 w-[30px] bg-cover bg-center bg-no-repeat" style="background-image: url(/img/bonfire.png)"></span>
      <span>
        <span class="block font-disp text-[1.05rem] font-semibold">Bonfire Networks</span>
        <span class="block text-[.82rem] text-ink-3 transition-colors group-hover:text-ink-2">Community-owned digital spaces.</span>
      </span>
    </a>
    <div class="flex items-center gap-3">
      <span class="font-smono text-[.68rem] tracking-[.08em] text-ink-3">OPEN SOURCE</span>
      <a class="github-button" href="https://github.com/bonfire-networks/bonfire-app" data-color-scheme="no-preference: dark_dimmed; light: light; dark: dark;" data-icon="octicon-star" data-size="large" data-show-count="true" aria-label="Star bonfire-networks/bonfire-app on GitHub">Star</a>
    </div>
  </div>

  <footer class="border-t border-ink/[0.07]">
    <div class="mx-auto grid grid-cols-2 gap-x-7 gap-y-10 px-7 py-10 sm:grid-cols-4 lg:grid-cols-[1fr_1.15fr_1fr_1fr_1.65fr] lg:py-12">
      <nav class="flex flex-col items-start gap-1.5" aria-labelledby="footer-explore">
        <h2 id="footer-explore" class="{{ ftitle }}">Explore</h2>
        <a href="/features" class="{{ flink }}">Features</a>
        <a href="/compare" class="{{ flink }}">Comparison table</a>
        <a href="/case-studies" class="{{ flink }}">Case studies</a>
        <a href="/about" class="{{ flink }}">About Bonfire</a>
        <a href="https://campground.bonfire.cafe" target="_blank" rel="noopener noreferrer" class="{{ flink }}">Try the campground <span aria-hidden="true">↗</span></a>
      </nav>

      <nav class="flex flex-col items-start gap-1.5" aria-labelledby="footer-launch">
        <h2 id="footer-launch" class="{{ ftitle }}">Launch your Bonfire</h2>
        <a href="/self-hosting" class="{{ flink }}">Self-host</a>
        <a href="/hosting" class="{{ flink }}">Cooperative hosting</a>
        <a href="/mosaic" class="{{ flink }}">Co-design with us</a>
        <a href="/start" class="{{ flink }}">Compare all three routes</a>
      </nav>

      <nav class="flex flex-col items-start gap-1.5" aria-labelledby="footer-ecosystem">
        <h2 id="footer-ecosystem" class="{{ ftitle }}">Ecosystem</h2>
        <a href="/community" class="{{ flink }}">Participate</a>
        <a href="/faq" class="{{ flink }}">FAQs</a>
        <a href="https://docs.bonfirenetworks.org/" target="_blank" rel="noopener noreferrer" class="{{ flink }}">Documentation <span aria-hidden="true">↗</span></a>
        <a href="https://github.com/bonfire-networks" target="_blank" rel="noopener noreferrer" class="{{ flink }}">Browse the source code <span aria-hidden="true">↗</span></a>
        <a href="/blog" class="{{ flink }}">Blog</a>
        <a href="/shop/" class="{{ flink }}">Merch</a>
      </nav>

      <nav class="flex flex-col items-start gap-1.5" aria-labelledby="footer-integration">
        <h2 id="footer-integration" class="{{ ftitle }}">Integration</h2>
        <a href="/telling" class="{{ flink }}">Telling</a>
        <a href="/ghost" class="{{ flink }}">Ghost</a>
      </nav>

      <div class="col-span-2 sm:col-span-3 lg:col-span-1">
        <h2 class="{{ ftitle }}">News from Bonfire</h2>
        <p class="mb-4 max-w-[34ch] text-[.88rem] leading-6 text-ink-2">Occasional updates about releases, community stories, and ways to take part.</p>
        <a
          href="/subscribe"
          class="inline-flex items-center gap-2 border-b border-spark/35 pb-1 font-smono text-[.74rem] font-bold tracking-[.04em] text-spark transition-[gap,border-color] hover:gap-3 hover:border-spark focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-flame/70"
        >
          Get Bonfire updates <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </footer>

  <div class="mx-auto flex max-w-[1140px] flex-col items-center justify-center gap-6 px-7 py-8 sm:flex-row sm:justify-between">
    <div class="flex items-center gap-8">
      <a href="https://opencollective.com/bonfire-networks" target="_blank" rel="noopener noreferrer"><img src="/img/oc.svg" alt="Open Collective" width="34" height="34" loading="lazy"></a>
      <a href="https://github.com/bonfire-networks" target="_blank" rel="noopener noreferrer"><img src="/img/opensource.svg" alt="Open source" width="89" height="34" loading="lazy"></a>
    </div>
    <nav class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm" aria-label="Legal and contact">
      <a class="font-smono text-[.72rem] text-ink-3 hover:text-spark" href="/contact/">Contact</a>
      <a class="font-smono text-[.72rem] text-ink-3 hover:text-spark" href="/presskit">Press kit</a>
      <a class="font-smono text-[.72rem] text-ink-3 hover:text-spark" href="/conduct">Code of conduct</a>
      <a class="font-smono text-[.72rem] text-ink-3 hover:text-spark" href="/privacy">Privacy</a>
      <a class="font-smono text-[.72rem] text-ink-3 hover:text-spark" href="/">Bonfire Networks 2026</a>
    </nav>
  </div>
</div>

<script async defer>

  document.addEventListener('DOMContentLoaded', function() {
  const lightImg = document.querySelector('.light-img');
  const darkImg = document.querySelector('.dark-img');

  function updateImage() {
    const theme = document.body.getAttribute('data-theme');
    if (theme === 'light') {
      lightImg.classList.remove('hidden');
      darkImg.classList.add('hidden');
    } else {
      lightImg.classList.add('hidden');
      darkImg.classList.remove('hidden');
    }
  }

  // Initial call
  updateImage();

  // Set up a MutationObserver to watch for changes to the data-theme attribute
  const observer = new MutationObserver(updateImage);
  observer.observe(document.body, { attributes: true, attributeFilter: ['data-theme'] });
});

</script>
