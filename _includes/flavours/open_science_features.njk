{# ============================================================
   OSN "What is included" bento.

   Content lives in _data/osn.json and is shared with /science
   (which renders the same five entries in the night palette).
   Edit the copy there, not here.

   This file is the light-theme markup, used on /app/open-science/
   via _includes/flavours/open-science.njk. `rounds` carries the
   corner treatment, which depends on grid position rather than on
   anything about the content, so it stays here.
   ============================================================ #}
{%- set rounds = [
  "lg:rounded-tl-4xl max-lg:rounded-t-4xl",
  "lg:rounded-tr-4xl",
  "lg:rounded-bl-4xl",
  "",
  "lg:rounded-br-4xl max-lg:rounded-b-4xl"
] %}
<div class="mt-4 grid gap-4 grid-cols-1 lg:grid-cols-6 lg:grid-rows-2 sm:mt-4">
  {%- for f in osn.included %}
  <div class="relative lg:col-span-{{ f.span }}">
    <div class="absolute inset-0 rounded-lg bg-white dark:bg-gray-800 {{ rounds[loop.index0] }}"></div>
    <div class="flex flex-col h-full overflow-hidden relative rounded-[calc(var(--radius-lg)+1px)]">
      <img alt="" class="h-80 w-full object-cover {{ f.pos }}" src="{{ f.img }}" width="765" height="391" loading="lazy">
      <div class="pt-4 p-10">
        <i class="ph-duotone {{ f.icon }} text-primary text-3xl" aria-hidden="true"></i>
        <p class="mt-2 tracking-tight dark:text-white font-medium text-gray-950 text-lg">{{ f.name }}</p>
        <p class="dark:text-gray-400 text-gray-600 max-w-lg mt-2 text-base/6">{{ f.text }}</p>
      </div>
    </div>
    <div class="absolute inset-0 rounded-lg dark:outline-white/15 outline outline-black/5 pointer-events-none shadow-sm {{ rounds[loop.index0] }}"></div>
  </div>
  {%- endfor %}
</div>
