            <span class="ml-auto hidden min-[521px]:inline font-smono text-[.62rem] tracking-[.1em] uppercase text-ink-3 whitespace-nowrap">{{ g.rows | length }} capabilities</span>
            <span class="flex-none ml-auto min-[521px]:ml-0 w-6 h-6 rounded-full border border-ink/20 flex items-center justify-center text-[.9rem] leading-none text-ink-3 transition-transform duration-200 group-open/d:rotate-45 group-hover/d:border-[color-mix(in_srgb,var(--acc)_45%,transparent)]" aria-hidden="true">+</span>
