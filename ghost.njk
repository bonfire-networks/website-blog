              <div class="font-disp font-[620] text-[.99rem] text-ink">{{ r.k | safe }}</div>
              <div class="text-ink-2 text-[.94rem]">{{ r.v | safe }}</div>
            </div>
            {%- endfor %}
          </div>
        </details>
        {%- endfor %}
      </div>
    </div></section>

    {# ============================================================
       7 · GETTING STARTED — two paths, same software. The Mosaic column
       is the primary CTA; the self-hosted column must never read as the
       lesser option, since it's the same AGPL code either way.
       ============================================================ #}
    <section id="start" class="py-[clamp(56px,7vw,90px)] border-t border-ink/[0.07] scroll-mt-[70px]" style="--acc:var(--color-flame)">
    <div class="max-w-[1140px] mx-auto px-7">
      <p class="{{ eyebrow }}"><i class="w-[9px] h-[9px] flex-none bg-[var(--acc)] [clip-path:polygon(50%_0,100%_50%,50%_100%,0_50%)]" aria-hidden="true"></i>Getting started</p>
      <h2 class="{{ display }}">Two ways in, and <span class="fire-text">no lock-in either way.</span></h2>
      <p class="{{ bodyp }}">Build it with us, or build it yourself. It's the <b>same AGPL-licensed software</b> in both cases. The difference is only how much of the work you'd like to do, and how much you want it shaped around your publication.</p>

      <div class="mt-6 max-w-[46rem] rounded-xl border border-dashed border-ink/15 px-[22px] py-[18px]">
        <p class="m-0 text-[.96rem] text-ink-2"><b class="text-ink font-semibold">Not on Ghost?</b> The comments widget already drops into any site: WordPress, Drupal, a static blog. And the deeper membership integration (single sign-on, tier and member sync) could be extended to other CMSes and Patreon-style membership tools. <a class="text-spark hover:underline" href="/contact">Tell us what you publish on →</a></p>
      </div>

      <div class="grid grid-cols-1 min-[941px]:grid-cols-2 gap-4 mt-[34px] items-start">

        {# --- with us: Mosaic --- #}
        <div class="rounded-xl border border-flame/30 bg-[linear-gradient(160deg,rgba(245,195,68,.08),rgba(255,223,130,.03))] px-[26px] py-7">
          <div class="flex items-center gap-3 flex-wrap">
            <span class="font-smono text-[.66rem] font-bold tracking-[.12em] uppercase text-flame">Bonfire Mosaic</span>
            <span class="font-smono text-[.6rem] tracking-[.1em] uppercase text-ink-3 border border-ink/15 rounded-full px-2.5 py-[3px]">Most publishers start here</span>
          </div>
          <h3 class="{{ subhead }} mt-3.5 mb-2.5">Build it with us</h3>
          <p class="{{ cellp }}">We sit down with you, work out how your publication and its readers actually operate, and shape the space around that: your branding, your structure, your rules. We wire up the Ghost side, get your archive in, and hand it over as yours.</p>

          {% set mos = [
            "Co-design sessions with your editorial and community people.",
            "Your identity and language throughout, not a template you fill in.",
            "The Ghost connection, tier sync and archive import set up for you.",
            "Yours outright when it's done: forkable, exportable, impossible to take back."
          ] %}
          <div class="grid gap-2.5 mt-5">
            {%- for m in mos %}
            <div class="grid grid-cols-[auto_1fr] gap-3 text-[.93rem] text-ink-2">
              <i class="ph-duotone ph-check-circle text-[17px] mt-[3px] text-flame" aria-hidden="true"></i><span>{{ m }}</span>
            </div>
            {%- endfor %}
          </div>

          <div class="flex flex-wrap gap-3 mt-6">
            <a class="{{ btnfire }}" href="https://cal.com/bonfire-networks/meet">Book a call</a>
            <a class="{{ btnline }}" href="/mosaic">How Mosaic works</a>
          </div>
          <p class="mt-5 font-smono text-[.7rem] text-ink-3 leading-[1.7]">◼ We work closely with a handful of communities a year, so there's a queue. Worth starting the conversation early.</p>
        </div>

        {# --- on your own --- #}
        <div class="rounded-xl border border-ink/15 px-[26px] py-7">
          <div class="flex items-center gap-3 flex-wrap">
            <span class="font-smono text-[.66rem] font-bold tracking-[.12em] uppercase text-ink-2">Self-hosted</span>
            <span class="font-smono text-[.6rem] tracking-[.1em] uppercase text-leaf border border-leaf/40 rounded-full px-2.5 py-[3px]">AGPL · free forever</span>
          </div>
          <h3 class="{{ subhead }} mt-3.5 mb-2.5">Or do it yourself</h3>
          <p class="{{ cellp }}">Nothing here is held back for paying customers. The extension is open source, the docs are public, and a technically comfortable team can have it running against their Ghost site in an afternoon. If you'd rather not touch a server, a managed host works too.</p>

          {% set own = [
            "No licence fee, no seat pricing, no feature locked behind a plan.",
            "Install it yourself, or point a managed host at it.",
            "Read the code, change it, fork it. It's AGPL.",
            "Ask questions in the open: we answer in the chat and on the tracker."
          ] %}
          <div class="grid gap-2.5 mt-5">
            {%- for o in own %}
            <div class="grid grid-cols-[auto_1fr] gap-3 text-[.93rem] text-ink-2">
              <i class="ph-duotone ph-terminal-window text-[17px] mt-[3px] text-leaf" aria-hidden="true"></i><span>{{ o }}</span>
            </div>
            {%- endfor %}
          </div>

          <div class="flex flex-wrap gap-3 mt-6">
            <a class="{{ btnline }}" href="/start">Install Bonfire</a>
            <a class="{{ btnline }}" href="{{ repo }}">The extension on GitHub</a>
            <a class="{{ btnline }}" href="/hosting">Managed hosting</a>
          </div>

          {# the old setup steps, kept but folded — reference, not a pitch #}
          {# <details class="group/d mt-6 rounded-xl border border-ink/15 bg-night-2/40 open:bg-night-2/70">
            <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden flex items-center justify-between gap-4 px-[18px] py-3.5 font-smono text-[.68rem] font-bold tracking-[.1em] uppercase text-ink-3 hover:text-ink">
              <span>What setting it up involves</span>
              <span class="flex-none w-5 h-5 rounded-full border border-ink/20 flex items-center justify-center text-[.8rem] leading-none transition-transform duration-200 group-open/d:rotate-45" aria-hidden="true">+</span>
            </summary>
            {% set steps = [
              "Add your Ghost site URL and Content API key.",
              "Add an Admin API key, for tiers, members, staff and gated content.",
              "Set a shared webhook secret.",
              "Pick a default import author, and a destination group or topic.",
              "Sync your tiers, members and staff.",
              "Choose which tiers may create accounts.",
              "Turn on auto-import and register the article webhooks in Ghost.",
              "Run the backfill over your existing articles.",
              "Paste the comments embed into your Ghost theme."
            ] %}
            <ol class="px-[18px] pb-5 pt-1 grid gap-2.5 list-none m-0">
              {%- for step in steps %}
              <li class="grid grid-cols-[auto_1fr] items-start gap-3">
                <span class="flex-none w-[22px] h-[22px] rounded-full flex items-center justify-center font-smono text-[.62rem] font-bold text-ink-3 border border-ink/15">{{ loop.index }}</span>
                <span class="text-[.92rem] text-ink-2 pt-[1px]">{{ step }}</span>
              </li>
              {%- endfor %}
            </ol>
            <p class="px-[18px] pb-5 m-0"><a class="font-smono text-[.75rem] text-spark border-b border-spark/35 pb-0.5 hover:border-spark" href="{{ repo }}">Configuration variables, webhook URLs and API examples →</a></p>
          </details> #}
        </div>

      </div>

      <div class="flex flex-wrap items-center justify-between gap-5 mt-4 rounded-xl border border-dashed border-ink/15 px-[26px] py-6">
        <p class="m-0 text-[.96rem] text-ink-2 max-w-[54rem]"><b class="text-ink font-semibold">Starting with us doesn't tie you to us.</b> A space we build together runs the same open code as one you install yourself, so you can take it in-house, hand it to another team, or carry on alone whenever you like.</p>
      </div>
    </div></section>

    {# ---------- closing ---------- #}
    <section class="text-center pt-[clamp(56px,7vw,96px)] pb-[clamp(76px,9vw,130px)] border-t border-ink/[0.07]">
    <div class="max-w-[1140px] mx-auto px-7">
      <h2 class="mx-auto max-w-[22ch] font-disp font-[560] text-[clamp(2rem,4.6vw,3.4rem)] leading-[1.05] text-balance [font-variation-settings:'opsz'_96]">Your readers are already here. <span class="fire-text">Give them a room.</span></h2>
      <p class="mx-auto mt-5 max-w-[46ch] text-[1.02rem] text-ink-2">Tell us about your publication (how you work, who reads you, what you'd want them doing together) and we'll tell you honestly whether this fits.</p>
      <div class="flex flex-wrap justify-center gap-3.5 mt-8">
        <a class="{{ btnfire }}" href="https://cal.com/bonfire-networks/meet">Book a call</a>
        <a class="{{ btnline }}" href="/contact">Send us a note</a>
      </div>
    </div></section>

    </main>

  </div>
</div>
