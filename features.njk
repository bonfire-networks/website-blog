      { icon: "ph-columns", name: "Saved presets", text: "Keep the feeds you built, name them, and arrange them however you like." },
      { icon: "ph-magnifying-glass", name: "Full-text search", text: "Find people, posts, and everything else that has been indexed on your instance." },
      { icon: "ph-hash", name: "Hashtags & mentions", text: "Tag what you post and reach the people you mean, across the whole network." },
      { icon: "ph-bookmarks-simple", name: "Topics", text: "Curated categories to organise conversation, so a subject has a home instead of scrolling past." },
      { icon: "ph-user-plus", name: "Follow anyone", text: "Follow people on any federated platform, at your own pace. Your network isn't limited to who else signed up here." }
