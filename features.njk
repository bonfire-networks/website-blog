      { icon: "ph-lock-key", name: "Boundaries", text: "Choose who can see, reply, quote, or even edit a post. Make it public but accept replies only from one circle, for instance." },
      { icon: "ph-identification-badge", name: "Custom roles", text: "Create roles and grant them to people or circles: what they can view, how they can interact, and anything else they may do." },
      { icon: "ph-plugs-connected", name: "Interoperable controls", text: "Boundaries speak the same language as GoToSocial interaction controls and Mastodon quote authorisations, so they hold up off your instance too." },
      { icon: "ph-envelope-simple", name: "Direct messages", text: "Private conversations, one to one or with a group." },
      { icon: "ph-user-switch", name: "Multiple profiles", text: "Several separate profiles on one account: different personas, or your org and your project alongside you." },
      { icon: "ph-users-four", name: "Shared profiles", text: "Give an organisation or project its own profile, and share access with the rest of your team." }
    ]
  },
  {
    id: "safety", acc: "var(--color-leaf)", link: "/moderation-toolkit", linktext: "Read about the federated moderation toolkit project →",
    eyebrow: "Safety & moderation",
    head: "Hold the line,", headhl: "together.",
    intro: "Moderation burns people out when it lands on one pair of shoulders. These are tools for spreading the weight, and for refusing the designs that make a place hostile in the first place.",
    cards: [
      { icon: "ph-flag", name: "Flag & review", text: "Anyone can flag; moderators see a queue and can remove what doesn't belong." },
      { icon: "ph-ghost", name: "Silence, ghost, or block", text: "Turn someone down, make yourself invisible to them, or cut them off entirely, at the user level or the whole instance." },
      { icon: "ph-list-checks", name: "Shared blocklists", text: "Lean on the work other communities have already done, rather than each of you meeting the same bad actor alone." },
      { icon: "ph-eye-slash", name: "No dark patterns", text: "Switch off follower counts, reaction counts, and infinite scroll. The things engineered to keep you hooked are optional here." },
      { icon: "ph-scales", name: "Govern, your way", text: "Custom roles, shared profiles, and consent-based tools, so power is distributed the way your community actually decides things." },
      { icon: "ph-sliders-horizontal", name: "Defaults, not dictates", text: "Admins set the defaults; every member can see exactly how the instance is configured, and override it for themselves." }
    ]
  },
  {
    id: "shape", acc: "var(--color-flame)", link: "/extensions", linktext: "Browse every extension →",
    eyebrow: "Make it yours",
    head: "Assembled from blocks,", headhl: "by you.",
    intro: "Bonfire is made of pluggable extensions all the way down. Even the core. Add what you need, fork what almost fits, drop what you don't want. No two communities end up with the same space.",
    cards: [
      { icon: "ph-puzzle-piece", name: "Extensions", text: "Every piece of Bonfire is a composable building block. Users enable and disable them; admins install new ones, fork them, or write their own.", link: "/extensions", linktext: "Browse the extensions" },
      { icon: "ph-palette", name: "Themes", text: "Change the look and feel: pick a theme, or make your own. No coding required." },
      { icon: "ph-faders", name: "Granular settings", text: "Tune how the app behaves in detail, overriding the choices made by designers, developers, and even your instance admins." },
      { icon: "ph-stack", name: "Flavours", text: "Start from a preset that's already close to what you need (social, community, coordination, open science), then adjust block by block.", link: "/apps", linktext: "See the flavours" },
      { icon: "ph-chats-circle", name: "Federated comments", text: "Embed the Telling on any static site: readers reply from Bonfire, Mastodon, or any ActivityPub account.", link: "/telling", linktext: "How the Telling works" },
      { icon: "ph-sign-in", name: "Single sign-on", text: "Speaks OpenID Connect and OAuth2 as both a client and a provider: members sign in with an account they already have, and your Bonfire can sign them in to your other apps." },
      { icon: "ph-code", name: "Build your own", text: "Documented libraries for accounts, boundaries, social, ActivityPub and economic flows. If it doesn't exist yet, you can write it." }
    ]
  },
  {
    id: "connect", img: "archi.png", shot: "Archipelago mode: choosing exactly which servers and people your instance federates with", acc: "var(--color-corn)", link: false,
    eyebrow: "Federation & reach",
    head: "Open to the world,", headhl: "as far as you like.",
    intro: "Your space is yours to open wide or keep closed. You decide who's invited through the door.",
    cards: [
      { icon: "ph-door", name: "Local & invite-only", text: "Quiet and warm, a space just for your people. Nobody joins your bonfire unless you say so." },
      { icon: "ph-graph", name: "Archipelago mode", text: "Federate only with allies and communities you trust, and form a private interconnected network together.", link: "/posts/bonfire-social-1-0-5-archipelago/", linktext: "About archipelago mode" },
      { icon: "ph-broadcast", name: "Fully Federated", text: "ActivityPub, so you can follow and be followed across Mastodon, PeerTube, Mobilizon, and every other Bonfire."},
      { icon: "ph-bridge", name: "Bridges beyond", text: "Protocol bridges reach Bluesky and the wider ATmosphere, so nobody is left out.", link: "https://fed.brid.gy/", linktext: "Bridged via BridgyFed" }
