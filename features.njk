      { icon: "ph-pen-nib", name: "A powerful composer", text: "Short updates or long-form posts. Add a title to start a thread, mention people, format your text, and share a quick thought or a full blog post." },
      { icon: "ph-text-aa", name: "Markdown friendly", text: "Rich formatting, so you can emphasise a point and give your writing a structure." },
      { icon: "ph-image-square", name: "Any media", text: "Enrich posts with photos, video, audio, and other files." },
      { icon: "ph-tree-structure", name: "Branching threads", text: "Replies can branch into sub-threads, so you follow a discussion without losing the context it grew from." },
      { icon: "ph-note-pencil", name: "Edit your posts", text: "Made a typo, or want to add context? Edit after publishing instead of deleting and reposting." },
      { icon: "ph-handshake", name: "Collaborate on posts", text: "Some posts are better written together. Write with your peers, or simply invite a trusted friend to check your spelling." }
    ]
  },
  {
    id: "feeds", img: "featurefilters.png", acc: "var(--color-corn)", eyebrow: "Feeds & discovery", link: false,
