  },
  {
    id: "data", img: "import_status.png", shot: "The import dashboard: circles, follows and posts arriving from another instance", acc: "var(--color-leaf)", link: false,
    eyebrow: "Your data",
    head: "Nothing here is", headhl: "holding you hostage.",
    intro: "A space can't be turned against its people when everyone is free to leave with everything. Moving instances shouldn't mean starting from scratch, so it doesn't.",
    cards: [
      { icon: "ph-download-simple", name: "Import everything", text: "Bring your account, your follows, and even your past posts from another instance, whether it runs Bonfire, Mastodon, or another fediverse app. Most tools can't move your posts across; this one can." },
      { icon: "ph-export", name: "Export everything", text: "Posts, relationships, settings, all of it. Your data belongs to you and you are not locked into any app or instance." },
      { icon: "ph-arrows-left-right", name: "Identify migration", text: "Move your profile to a new home and stay yourself: your followers are redirected, your old address points to the new one, and your identity carries across intact." },
