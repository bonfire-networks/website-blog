{# shared class strings #}
{% set eyebrow = "flex items-center gap-3 font-smono text-[.72rem] font-bold tracking-[.18em] text-[var(--acc)]" %}
{% set display = "mt-[22px] font-disp font-[560] text-[clamp(1.9rem,4vw,3rem)] leading-[1.06] text-balance [font-variation-settings:'opsz'_96]" %}
{% set cell = "group card rounded-xl border border-ink/15 bg-gradient-to-b from-night-2 to-night px-[26px] py-7 hover:border-[color-mix(in_srgb,var(--acc)_40%,transparent)]" %}
{% set ic = "w-[42px] h-[42px] rounded-[11px] flex items-center justify-center text-[22px] text-[var(--acc)] bg-[color-mix(in_srgb,var(--acc)_7%,transparent)] border border-[color-mix(in_srgb,var(--acc)_24%,transparent)] transition-all duration-[250ms] ease-[cubic-bezier(.22,.8,.3,1)] group-hover:-translate-y-0.5 group-hover:bg-[color-mix(in_srgb,var(--acc)_13%,transparent)]" %}
{% set cellh = "font-disp font-[620] text-[1.16rem] mt-[15px] mb-[7px]" %}
{% set cellp = "text-ink-2 text-[.94rem]" %}
{% set shotph = "w-full aspect-[16/7] rounded-xl border border-dashed border-ink/15 flex flex-col items-center justify-center gap-2.5 font-smono text-[.78rem] text-ink-3 bg-[repeating-linear-gradient(135deg,transparent_0_22px,rgba(242,236,219,.025)_22px_44px)]" %}
{% set soon = "badge h-auto shrink-0 rounded-full bg-transparent border-ink/15 px-2.5 py-[3px] font-smono text-[.58rem] tracking-[.1em] uppercase text-ink-3" %}
{% set more = "inline-flex items-center gap-[9px] mt-[30px] pb-[3px] font-smono text-[.8rem] tracking-[.05em] text-spark border-b border-spark/35 hover:border-spark" %}
{% set jump = "font-smono text-[.72rem] tracking-[.06em] text-ink-2 border border-ink/15 rounded-full px-3.5 py-[7px] hover:text-spark hover:border-flame" %}
{% set btnfire = "btn h-auto min-h-0 rounded-full border-0 px-6 py-[.9rem] font-smono text-[.82rem] font-bold tracking-[.05em] text-[#221302] bg-gradient-to-br from-spark via-flame to-ember hover:from-spark hover:via-flame hover:to-ember shadow-[0_6px_26px_-8px_rgba(232,145,43,.55)]" %}
{% set btnline = "btn btn-ghost h-auto min-h-0 rounded-full px-6 py-[.9rem] font-smono text-[.82rem] font-bold tracking-[.05em] text-ink border border-ink/15 bg-ink/[0.03] hover:border-flame hover:text-spark hover:bg-ink/[0.03]" %}

<div class="relative overflow-x-clip bg-night text-ink font-body leading-[1.58] antialiased selection:bg-ember selection:text-[#160c02]">
  <div class="v2-ambient" aria-hidden="true"></div>
  <div class="relative z-[1]">

    {# ---------- hero ---------- #}
    <header class="pt-10 pb-[clamp(40px,5vw,60px)]">
    <div class="max-w-[1140px] mx-auto px-7">
      <p class="mb-[26px] font-smono text-[.7rem] tracking-[.08em] text-ink-3"><a class="hover:text-spark" href="/">Bonfire</a><span class="mx-2">/</span>Features</p>
      <h1 class="font-disp font-semibold text-[clamp(2.1rem,5vw,3.7rem)] leading-[1.05] tracking-[-.02em] text-balance max-w-[18ch] [font-variation-settings:'opsz'_96]">Every block, <span class="fire-text">at a glance.</span></h1>
      <p class="mt-[18px] text-[1.08rem] text-ink-2 max-w-[54ch] [&_b]:text-ink [&_b]:font-semibold">There's no single "Bonfire app" with a fixed feature list. It's a kit of composable blocks: <b>switch on what your community needs, leave out the rest</b>. Here's everything in the kit, including what we haven't finished yet.</p>

      <nav class="flex flex-wrap gap-2 mt-9" aria-label="Jump to a section">
        {%- for s in sections %}
        <a class="{{ jump }}" href="#{{ s.id }}">{{ s.eyebrow }}</a>
        {%- endfor %}
      </nav>
    </div></header>

    {# ---------- the catalogue ---------- #}
    <main>
    {% for s in sections %}
    <section id="{{ s.id }}" class="py-[clamp(56px,7vw,96px)] border-t border-ink/[0.07] scroll-mt-[70px]" style="--acc:{{ s.acc }}">
    <div class="max-w-[1140px] mx-auto px-7">

      <p class="{{ eyebrow }}"><i class="w-[9px] h-[9px] flex-none bg-[var(--acc)] [clip-path:polygon(50%_0,100%_50%,50%_100%,0_50%)]" aria-hidden="true"></i>{{ s.eyebrow }}</p>
      <h2 class="{{ display }}">{{ s.head }} <span class="{{ 'corn-text' if s.acc == 'var(--color-corn)' else 'fire-text' }}">{{ s.headhl }}</span></h2>
      <p class="mt-5 text-[1.02rem] text-ink-2 max-w-[44rem]">{{ s.intro }}</p>

      {% if s.link %}<a class="{{ more }}" href="{{ s.link }}">{{ s.linktext }}</a>{% endif %}

      <div class="grid grid-cols-1 min-[681px]:grid-cols-2 min-[1001px]:grid-cols-3 gap-3.5 mt-[34px]">
        {%- for c in s.cards %}
        <div class="{{ cell }}">
          <div class="flex items-start justify-between gap-3">
            <span class="{{ ic }}" aria-hidden="true"><i class="ph-duotone {{ c.icon }}"></i></span>
            {% if c.status %}<span class="{{ soon }}">{{ c.status }}</span>{% endif %}
          </div>
          <h3 class="{{ cellh }}">{{ c.name }}</h3>
          <p class="{{ cellp }}">{{ c.text }}</p>
        </div>
        {%- endfor %}
      </div>

      {# TODO: swap each placeholder for the real screenshot — replace `shot:` with
         `image:` + `alt:` in the section data above, and this block with an <img>. #}
      {% if s.shot %}
      <figure class="m-0 mt-4">
        <img class="{{ shotph }}" src="/img/{{ s.id }}" alt="{{ s.shot }}">
      </figure>
      {% endif %}

    </div></section>
    {% endfor %}
    </main>

    {# ---------- principles ---------- #}
    <section class="py-[clamp(56px,7vw,96px)] border-t border-ink/[0.07]">
    <div class="max-w-[1140px] mx-auto px-7">
      <p class="flex items-center gap-3 font-smono text-[.72rem] font-bold tracking-[.18em] text-ink-3"><i class="w-[9px] h-[9px] flex-none bg-ink-3 [clip-path:polygon(50%_0,100%_50%,50%_100%,0_50%)]" aria-hidden="true"></i>Underneath all of it</p>
      <div class="flex flex-wrap gap-2.5 mt-[22px]">
        {%- for p in principles %}
        <span class="flex items-center gap-2.5 rounded-full border border-ink/15 bg-ink/[0.03] px-4 py-2.5 font-smono text-[.82rem] text-ink-2">
          <i class="ph-duotone {{ p.icon }} text-[18px] text-flame" aria-hidden="true"></i>{{ p.name }}
        </span>
        {%- endfor %}
      </div>
    </div></section>

    {# ---------- closing CTA ---------- #}
    <section class="text-center pt-[clamp(60px,8vw,110px)] pb-[clamp(80px,9vw,140px)] border-t border-ink/[0.07]">
    <div class="max-w-[1140px] mx-auto px-7">
      <h2 class="mx-auto max-w-[20ch] font-disp font-[560] text-[clamp(2rem,4.6vw,3.4rem)] leading-[1.05] text-balance [font-variation-settings:'opsz'_96]">Now go and build <span class="fire-text">something with them.</span></h2>
      <div class="flex flex-wrap justify-center gap-3.5 mt-[34px]">
        <a class="{{ btnfire }}" href="/start">Install Bonfire</a>
        <a class="{{ btnline }}" href="https://docs.bonfirenetworks.org">Read the documentation</a>
        <a class="{{ btnline }}" href="/mosaic">Build it with us</a>
      </div>
      <p class="mt-[26px] font-smono text-[.82rem] text-ink-3">Missing a block? <a class="text-spark border-b border-spark/35 pb-0.5 hover:border-spark" href="/contact">Tell us what your community needs.</a></p>
    </div></section>

  </div>
</div>
