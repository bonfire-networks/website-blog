      <div class="flex flex-wrap items-center gap-2.5 mt-[22px]">
        {% for b in backers %}
        <a class="flex items-center gap-[9px] rounded-full border border-ink/15 bg-night-2 py-[5px] pl-[5px] pr-3.5 hover:border-flame" href="{{ b.href }}">
          {% if b.img %}<img class="w-[26px] h-[26px] rounded-full object-cover flex-none" src="{{ b.img }}" alt="" loading="lazy">{% else %}<span class="w-[26px] h-[26px] rounded-full bg-night-3 text-ink-3 font-smono text-[.6rem] flex items-center justify-center flex-none">{{ b.ini }}</span>{% endif %}
