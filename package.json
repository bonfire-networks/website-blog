{
  "name": "bonfire-website",
  "version": "1.0.2",
  "description": "Public bonfire website.",
  "packageManager": "yarn@4.17.1",
  "scripts": {
    "clean": "del-cli _site",
    "start": "npm run clean && concurrently \"eleventy --watch --serve\" \"postcss css/index.css --o _site/css/style_v2.css --watch\"",
    "build": "npm run clean && ELEVENTY_PRODUCTION=true eleventy && NODE_ENV=production postcss css/index.css --o _site/css/style_v2.css"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/11ty/eleventy-base-blog.git"
  },
  "author": {
    "name": "ivan minutillo",
    "email": "ivanminutillo@outlook.it",
    "url": "https://ivan.cafe"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/11ty/eleventy-base-blog/issues"
  },
  "homepage": "https://github.com/11ty/eleventy-base-blog#readme",
  "dependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@11ty/eleventy-fetch": "^4.0.0",
    "@11ty/eleventy-navigation": "^0.1.6",
    "@11ty/eleventy-plugin-rss": "^1.1.1",
    "@alpinejs/focus": "^3.13.3",
    "@alpinejs/intersect": "^3.11.1",
    "@octokit/core": "^4.2.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@tailwindcss/typography": "^0.5.2",
    "autoprefixer": "^10.4.20",
    "axios": "^1.6.3",
    "concurrently": "^7.0.0",
    "daisyui": "^5.4.2",
    "del-cli": "^4.0.0",
    "dotenv": "^16.3.1",
    "esbuild": "^0.14.0",
    "gray-matter": "^4.0.3",
    "html-minifier": "^4.0.0",
    "luxon": "^1.26.0",
    "markdown-it": "^12.0.4",
    "markdown-it-anchor": "^7.1.0",
    "md5": "^2.3.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.49",
    "postcss-cli": "^11",
    "tailwindcss": "^4.1.16"
  },
  "devDependencies": {
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "@iconify-json/arcticons": "^1.2.56",
