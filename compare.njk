      cells: [["yes"],["yes"],["partial","AP plugin"],["no"],["yes"],["partial","categories"],["partial","plugin"],["yes"],["no"],["yes","hub app / PWA","icon-[ph--app-window-bold]"],["yes"],["yes","forum"]] },
    { name: "BuddyPress / WordPress", logo: "icon-[simple-icons--wordpress]", price: "Free (GPL)", model: "Free (GPL) + your hosting",
      cells: [["yes"],["yes"],["partial","blog only"],["no"],["yes"],["yes"],["partial","plugin"],["partial","plugin"],["partial","LMS plugin"],["partial"],["yes"],["partial"]] }
  ] },
