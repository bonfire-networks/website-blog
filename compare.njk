    { name: "Thinkific", dom: "thinkific.com", price: "Course SaaS", model: "Course SaaS",
      cells: [["no"],["no"],["no"],["no"],["partial"],["partial"],["no"],["no"],["yes"],["partial"],["partial"],["partial"]] },
    { name: "Podia", dom: "podia.com", price: "Creator SaaS", model: "Creator SaaS",
      cells: [["no"],["no"],["no"],["no"],["partial"],["partial","spaces"],["no"],["no"],["yes"],["partial"],["partial"],["partial"]] },
    { name: "Fourthwall", dom: "fourthwall.com", price: "Creator · %", model: "Creator commerce · % fee",
      cells: [["no"],["no"],["no"],["no"],["partial","subdomain"],["no","→ Discord"],["partial"],["partial"],["no"],["partial"],["partial"],["no"]] },
    { name: "HighLevel", dom: "gohighlevel.com", price: "Agency SaaS", model: "Agency reseller SaaS",
