---
layout: layouts/base.njk
title: "Bonfire vs Circle, Skool, Mighty Networks, Discord & more — the open, federated community platform"
description: "How Bonfire compares to community SaaS (Circle, Mighty Networks, Skool, Bettermode…), creator platforms, team chat (Slack, Discord), messaging (Signal, WhatsApp), open source (Discourse, BuddyPress) and ATproto (Acorn, Roundabout): open source, self-hostable, federated, and yours."
---
{# ============================================================
   V2 · COMPARE — Bonfire vs the community-platform landscape.
   Transposed: axes are rows, products are narrow columns. Icons are
   Iconify (compile-time via @iconify/tailwind4 — literal icon classes
   classes so only referenced icons are inlined). Category-level,
   structural claims only, "as of 2026". Not a hit piece — mission-aligned
   projects are treated fairly in the notes below. Cell detail is on hover.
   ============================================================ #}
{% set eyebrow = "flex items-center gap-3 font-smono text-[.72rem] font-bold tracking-[.18em] uppercase text-[var(--acc)]" %}
{% set display = "mt-[22px] font-disp font-[560] text-[clamp(1.9rem,4vw,3rem)] leading-[1.06] text-balance [font-variation-settings:'opsz'_96]" %}
{% set cell = "card rounded-xl border border-ink/15 bg-gradient-to-b from-night-2 to-night px-[26px] py-7" %}
{% set cellh = "font-disp font-[620] text-[1.14rem] mt-1 mb-[7px]" %}
{% set cellp = "text-ink-2 text-[.94rem]" %}
{% set btnfire = "btn h-auto min-h-0 rounded-full border-0 px-6 py-[.9rem] font-smono text-[.82rem] font-bold tracking-[.05em] text-[#221302] bg-gradient-to-br from-spark via-flame to-ember hover:from-spark hover:via-flame hover:to-ember shadow-[0_6px_26px_-8px_rgba(232,145,43,.55)]" %}
{% set btnline = "btn btn-ghost h-auto min-h-0 rounded-full px-6 py-[.9rem] font-smono text-[.82rem] font-bold tracking-[.05em] text-ink border border-ink/15 bg-ink/[0.03] hover:border-flame hover:text-spark hover:bg-ink/[0.03]" %}
{% set rowlabel = "sticky left-0 z-[2] bg-night w-[150px] min-w-[150px] px-4 py-2.5 text-left font-smono text-[.64rem] font-medium text-ink-2 border-r border-ink/[0.07]" %}
{% set stickyBonfire = "sticky left-[150px] z-[3] bg-[color-mix(in_srgb,var(--color-flame)_12%,var(--color-night))]" %}
{% set stickyBonfireCell = "sticky left-[150px] z-[1] bg-[color-mix(in_srgb,var(--color-flame)_9%,var(--color-night))]" %}
{# Switch to "logos" to restore the original platform-logo headers. #}
{% set platformHeaderStyle = "logos" %}

{# status mark — plain check/minus/x/clock by default. A cell can pass its own icon
   to encode a *different kind* of yes/partial (e.g. the three flavours of mobile app),
   coloured by status. Literal Iconify classes so Tailwind inlines only what's used. #}
{% macro mark(s, icon) %}
  {%- if s == 'yes' -%}<span class="{{ icon if icon else 'icon-[ph--check-bold]' }} text-leaf align-middle text-[1.1rem]" aria-hidden="true"></span>
  {%- elif s == 'partial' -%}<span class="{{ icon if icon else 'icon-[ph--minus-bold]' }} text-corn-2 align-middle text-[1.1rem]" aria-hidden="true"></span>
  {%- elif s == 'soon' -%}<span class="icon-[ph--clock-bold] text-flame align-middle text-[1.1rem]" aria-hidden="true"></span>
  {%- else -%}<span class="icon-[ph--x-bold] text-ink-3/50 align-middle text-[1.1rem]" aria-hidden="true"></span>
  {%- endif -%}
{% endmacro %}

{# axes (12), rendered in two labelled bands. Each product's `cells` matches this order.
   Cell = [status, "short hover note"?, "icon override"?]. The icon override is for rows
   where "yes" has distinct flavours worth showing — e.g. mobile app:
     device-mobile = your own branded app · app-window = one shared platform app · stack = an ecosystem of clients #}
{% set axes = ["Open source","Self-host & own data","Federated","End-to-end encryption","Your brand & domain","Groups & spaces","Events & calendar","Polls & decisions","Courses / learning","Mobile app","Import & export","Governance & moderation"] %}

{# pricing-model icons for the Model row (literal classes so Tailwind inlines them) #}
{% set paymap = {
  "free": "icon-[roentgen--free]",
  "paid": "icon-[material-symbols--paid-outline]",
  "freemium": "icon-[ph--coins]",
  "ads": "icon-[mdi--advertisements]",
  "nonprofit": "icon-[ph--hand-heart]"
} %}

