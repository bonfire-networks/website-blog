    { name: "WhatsApp", logo: "icon-[simple-icons--whatsapp]", price: "Free · Meta", model: "Free · Meta",
      cells: [["no"],["no"],["no"],["yes","default"],["no"],["yes","groups"],["partial","events"],["partial","poll"],["no"],["yes","platform app","icon-[ph--app-window-bold]"],["partial"],["no"]] }
