  ] },
  { cat: "Membership & newsletter (community = bolt-on)", rows: [
    { name: "Patreon", logo: "icon-[simple-icons--patreon]", price: "8–12% + fees", model: "Membership · 8–12% + payment fees",
      cells: [["no"],["no"],["no"],["no"],["no","patreon.com/you"],["partial","up to 10 chats"],["no"],["partial","poll"],["no"],["yes","platform app","icon-[ph--app-window-bold]"],["partial","member CSV"],["partial","creator-led"]] },
    { name: "Substack", logo: "icon-[simple-icons--substack]", price: "10% of paid", model: "Freemium · 10% of paid subs",
      cells: [["no"],["no"],["no"],["no"],["partial","custom domain"],["partial","one chat + Notes"],["no"],["partial","poll"],["no"],["yes","platform app","icon-[ph--app-window-bold]"],["yes","posts + list"],["partial"]] }
  ] }
